{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motif.local/schemas/motif-project.schema.json",
  "$comment": "GENERATED by tools/gen-project-schema.mjs from src-v5/modules/07-timeline.js. Do not edit by hand.",
  "title": "Motif project (motif-style-lab/preset@2)",
  "description": "The project object exactly as timeline.sanitizeProject() produces it (format \"motif-style-lab/preset@2\"). Saved presets wrap it: see $defs.presetFile. Versioning: \"format\" names the document version. Readers accept older formats and migrate on load; writers always write the current one. Migration notes: motif-style-lab/preset@1 (one look: { format, look: { styleId, params, shared }, aspect }) is migrated by timeline.fromV1() to a one-layer @2 project; shared.loop/grain/vignette move to finish.loop/grain/vignette. Within @2, sanitizeProject() is the migration for additive changes: unknown fields are dropped, missing fields take defaults, numbers are clamped to their ranges, at most 4 layers / 24 custom palettes / 16 audio maps are kept. Layer params depend on the style (built-in or kit \"<kit>/<style>\"); their ranges come from the style or the kit manifest (schemas/motif-kit-2.schema.json), so here they are only typed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "layers",
    "active",
    "finish",
    "palettes",
    "keys",
    "audio",
    "output"
  ],
  "properties": {
    "format": {
      "const": "motif-style-lab/preset@2"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "active": {
      "type": "string",
      "description": "id of the selected layer"
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop",
        "shutter",
        "samples",
        "glow",
        "glowThreshold",
        "glowRadius",
        "chroma",
        "depth",
        "depthMode",
        "focus",
        "black",
        "white",
        "gamma",
        "gmap",
        "gmapMode",
        "grain",
        "vignette"
      ],
      "properties": {
        "loop": {
          "type": "number",
          "minimum": 1,
          "maximum": 32,
          "default": 6,
          "description": "Loop length (s)"
        },
        "shutter": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "default": 0,
          "description": "Shutter angle (°)"
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32,
          "default": 8,
          "description": "Samples"
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Glow"
        },
        "glowThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6,
          "description": "Threshold"
        },
        "glowRadius": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1,
          "default": 0.4,
          "description": "Radius"
        },
        "chroma": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Chromatic offset"
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Depth blur"
        },
        "depthMode": {
          "enum": [
            "tilt",
            "radial",
            "luma"
          ],
          "default": "tilt",
          "description": "Depth from"
        },
        "focus": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "Focus"
        },
        "black": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0,
          "description": "Black point"
        },
        "white": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1,
          "default": 1,
          "description": "White point"
        },
        "gamma": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 3,
          "default": 1,
          "description": "Gamma"
        },
        "gmap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Gradient map"
        },
        "gmapMode": {
          "enum": [
            "palette",
            "duotone",
            "ink"
          ],
          "default": "palette",
          "description": "Map colours"
        },
        "grain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.12,
          "description": "Grain"
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.15,
          "description": "Vignette"
        }
      }
    },
    "palettes": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/customPalette"
      }
    },
    "keys": {
      "type": "object",
      "description": "Keyframes by value path: L:<layerId>:p|s|c:<key> (style param, shared, composite) or F:<key> (finish). u is loop phase 0..1.",
      "propertyNames": {
        "pattern": "^(L:[^:]+:[psc]:.+|F:.+)$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "u",
            "v",
            "e"
          ],
          "properties": {
            "u": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.99999
            },
            "v": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            "e": {
              "enum": [
                "linear",
                "smooth",
                "in",
                "out",
                "hold"
              ]
            }
          }
        }
      }
    },
    "audio": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/audio"
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "space",
        "broadcastSafe",
        "fps"
      ],
      "properties": {
        "space": {
          "enum": [
            "srgb",
            "p3",
            "rec709"
          ]
        },
        "broadcastSafe": {
          "type": "boolean"
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        }
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "styleId",
        "params",
        "shared",
        "comp",
        "visible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "styleId": {
          "type": "string",
          "description": "built-in style id, or \"<kit id>/<style id>\" for a kit style"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "palette",
            "invert",
            "tempo",
            "phase",
            "seed",
            "zoom",
            "rotate"
          ],
          "properties": {
            "palette": {
              "type": "string",
              "minLength": 1,
              "default": "signal",
              "description": "Palette"
            },
            "invert": {
              "type": "boolean",
              "default": false,
              "description": "Invert"
            },
            "tempo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "default": 1,
              "description": "Tempo (×)"
            },
            "phase": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0,
              "description": "Phase"
            },
            "seed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999,
              "default": 417,
              "description": "Seed"
            },
            "zoom": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2,
              "default": 1,
              "description": "Zoom (×)"
            },
            "rotate": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "default": 0,
              "description": "Rotate (°)"
            }
          }
        },
        "comp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "opacity",
            "blend",
            "fill",
            "mask",
            "maskSize",
            "maskFeather",
            "maskX",
            "maskY",
            "maskAngle",
            "maskInvert"
          ],
          "properties": {
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1,
              "description": "Opacity"
            },
            "blend": {
              "enum": [
                "source-over",
                "multiply",
                "screen",
                "overlay",
                "lighter",
                "darken",
                "lighten",
                "difference",
                "exclusion",
                "soft-light",
                "color-dodge"
              ],
              "default": "source-over",
              "description": "Blend"
            },
            "fill": {
              "type": "boolean",
              "default": false,
              "description": "Fill background"
            },
            "mask": {
              "enum": [
                "none",
                "circle",
                "rect",
                "band",
                "gradient",
                "matte-alpha",
                "matte-luma"
              ],
              "default": "none",
              "description": "Mask"
            },
            "maskSize": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5,
              "default": 0.6,
              "description": "Mask size"
            },
            "maskFeather": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.2,
              "description": "Feather"
            },
            "maskX": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5,
              "default": 0,
              "description": "Mask X"
            },
            "maskY": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5,
              "default": 0,
              "description": "Mask Y"
            },
            "maskAngle": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "default": 0,
              "description": "Mask angle (°)"
            },
            "maskInvert": {
              "type": "boolean",
              "default": false,
              "description": "Invert mask"
            }
          }
        },
        "visible": {
          "type": "boolean"
        },
        "media": {
          "type": "object",
          "maxProperties": 4,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9]{0,15}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset",
              "name",
              "kind",
              "w",
              "h",
              "dur",
              "fit",
              "timing"
            ],
            "properties": {
              "asset": {
                "type": "string",
                "pattern": "^m_[a-z0-9]{6,40}$"
              },
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "kind": {
                "enum": [
                  "image",
                  "video"
                ]
              },
              "w": {
                "type": "integer",
                "minimum": 0
              },
              "h": {
                "type": "integer",
                "minimum": 0
              },
              "dur": {
                "type": "number",
                "minimum": 0
              },
              "fit": {
                "enum": [
                  "fill",
                  "fit",
                  "stretch"
                ]
              },
              "timing": {
                "enum": [
                  "loop",
                  "free"
                ]
              }
            }
          }
        }
      }
    },
    "customPalette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "bg",
        "ink",
        "a",
        "locks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c-[a-z0-9]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "a": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "locks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bpm",
        "bars",
        "offset",
        "snap",
        "name",
        "maps"
      ],
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 40,
          "maximum": 240
        },
        "bars": {
          "enum": [
            1,
            2,
            4,
            8
          ]
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "snap": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "maps": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "band",
              "path",
              "amount",
              "smooth"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "band": {
                "enum": [
                  "sub",
                  "bass",
                  "lowmid",
                  "mid",
                  "highmid",
                  "high",
                  "level",
                  "onset"
                ]
              },
              "path": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "smooth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "presetFile": {
      "type": "object",
      "description": "A saved preset (.json export): { format: \"motif-style-lab/preset@2\", styles: [names], aspect, project } — project omits \"active\".",
      "required": [
        "format",
        "project"
      ],
      "properties": {
        "format": {
          "const": "motif-style-lab/preset@2"
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aspect": {
          "type": "string"
        },
        "project": {
          "type": "object"
        }
      }
    }
  }
}
