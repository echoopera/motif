{
  "format": "motif-kit@1",
  "id": "kinetic-subdivision",
  "name": "Kinetic Subdivision",
  "version": "0.2.1",
  "author": "Echo Opera",
  "description": "Ten subdivision and image-displacement treatments with smooth looped motion. Attach an image or video to a layer to treat it; without one, a procedural source plays.",
  "license": "All rights reserved",
  "accent": "#E97445",
  "common": "common.glsl",
  "inputs": [
    {
      "id": "source",
      "type": "media",
      "label": "Source",
      "fit": "fill",
      "hint": "Photo or video to subdivide. Without one, the kit's procedural source plays."
    }
  ],
  "palettes": [
    {
      "id": "field",
      "name": "Field Orange",
      "bg": "#111310",
      "ink": "#F4F2E8",
