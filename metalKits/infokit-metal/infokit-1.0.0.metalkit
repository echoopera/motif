iforms.swift; 144 bytes) --------------------------------------------------\nstruct MotifUniforms {\n  float2 res;      // pass resolution in pixels\n  float  p;        // loop phase 0..1\n  float  L;        // effective loop length in seconds\n  float  seed;     // 1..9999\n  float  safe;     // 1 = photosensitive-safe limiter\n  float  encode;   // 0 = linear premultiplied RGBA, 1 = web-identical final (sRGB, dithered, premultiplied)\n  float  _pad;\n  float4 bg;       // palette, linear RGB in xyz\n  float4 ink;\n  float4 a0;\n  float4 a1;\n  float4 a2;\n  float4 media0;   // media input 0: x = attached (0/1), y = video time, zw = pixel size\n  float4 media1;\n};\n\n// ---- textures: GL samples with v = 0 at the bottom; Metal stores row 0 on top, so v is flipped here ------------\nstruct MTex { texture2d<float> t; };\nconstexpr sampler M_smp(coord::normalized, address::clamp_to_edge, filter::linear, mip_filter::linear);\ninline float4 M_tex(MTex s, float2 uv) { return s.t.sample(M_smp, float2(uv.x, 1.0 - uv.y)); }\ninline float4 M_texLod(MTex s, float2 uv, float lod) { return s.t.sample(M_smp, float2(uv.x, 1.0 - uv.y), level(lod)); }\ninline float4 M_texelFetch(MTex s, int2 p, int lod) { return s.t.read(uint2(p.x, int(s.t.get_height(uint(lod))) - 1 - p.y), uint(lod)); }\ninline int2 M_texSize(MTex s, int lod) { return int2(int(s.t.get_width(uint(lod))), int(s.t.get_height(uint(lod)))); }\n\n// ---- GLSL maths that Metal lacks or spells differently --------------------------------------------------------\n// GLSL lets scalars stand in for vectors in min/max/clamp/mix/step/smoothstep/mod; Metal's overloads do not.\ntemplate <typename T> inline T M_min(T a, T b) { return metal::min(a, b); }\ntemplate <typename T> inline T M_max(T a, T b) { return metal::max(a, b); }\ntemplate <typename T> inline T M_clamp(T x, T lo, T hi) { return metal::clamp(x, lo, hi); }\ntemplate <typename T> inline T M_mix(T a, T b, T t) { return metal::mix(a, b, t); }\ntemplate <typename T> inline T M_mix(T a, T b, bool t) { return t ? b : a; }\ntemplate <typename T> inline T M_step(T e, T x) { return metal::step(e, x); }\ntemplate <typename T> inline T M_mod(T x, T y) { return x - y * metal::floor(x / y); }\ninline float2 M_min(float2 a, float b) { return metal::min(a, float2(b)); }\ninline float2 M_max(float2 a, float b) { return metal::max(a, float2(b)); }\ninline float2 M_clamp(float2 x, float lo, float hi) { return metal::clamp(x, float2(lo), float2(hi)); }\ninline float2 M_mix(float2 a, float2 b, float t) { return metal::mix(a, b, float2(t)); }\ninline float2 M_mix(float2 a, float2 b, bool2 t) { return select(a, b, t); }\ninline float2 M_step(float e, float2 x) { return metal::step(float2(e), x); }\ninline float2 M_mod(float2 x, float y) { return x - float2(y) * metal::floor(x / float2(y)); }\ninline float3 M_min(float3 a, float b) { return metal::min(a, float3(b)); }\ninline float3 M_max(float3 a, float b) { return metal::max(a, float3(b)); }\ninline float3 M_clamp(float3 x, float lo, float hi) { return metal::clamp(x, float3(lo), float3(hi)); }\ninline float3 M_mix(float3 a, float3 b, float t) { return metal::mix(a, b, float3(t)); }\ninline float3 M_mix(float3 a, float3 b, bool3 t) { return select(a, b, t); }\ninline float3 M_step(float e, float3 x) { return metal::step(float3(e), x); }\ninline float3 M_mod(float3 x, float y) { return x - float3(y) * metal::floor(x / float3(y)); }\ninline float4 M_min(float4 a, float b) { return metal::min(a, float4(b)); }\ninline float4 M_max(float4 a, float b) { return metal::max(a, float4(b)); }\ninline float4 M_clamp(float4 x, float lo, float hi) { return metal::clamp(x, float4(lo), float4(hi)); }\ninline float4 M_mix(float4 a, float4 b, float t) { return metal::mix(a, b, float4(t)); }\ninline float4 M_mix(float4 a, float4 b, bool4 t) { return select(a, b, t); }\ninline float4 M_step(float e, float4 x) { return metal::step(float4(e), x); }\ninline float4 M_mod(float4 x, float y) { return x - float4(y) * metal::floor(x / float4(y)); }\ninline int2 M_min(int2 a, int b) { return metal::min(a, int2(b)); }\ninline int2 M_max(int2 a, int b) { return metal::max(a, int2(b)); }\ninline int2 M_clamp(int2 x, int lo, int hi) { return metal::clamp(x, int2(lo), int2(hi)); }\ninline int3 M_min(int3 a, int b) { return metal::min(a, int3(b)); }\ninline int3 M_max(int3 a, int b) { return metal::max(a, int3(b)); }\ninline int3 M_clamp(int3 x, int lo, int hi) { return metal::clamp(x, int3(lo), int3(hi)); }\ninline int4 M_min(int4 a, int b) { return metal::min(a, int4(b)); }\ninline int4 M_max(int4 a, int b) { return metal::max(a, int4(b)); }\ninline int4 M_clamp(int4 x, int lo, int hi) { return metal::clamp(x, int4(lo), int4(hi)); }\ninline uint2 M_min(uint2 a, uint b) { return metal::min(a, uint2(b)); }\ninline uint2 M_max(uint2 a, uint b) { return metal::max(a, uint2(b)); }\ninline uint2 M_clamp(uint2 x, uint lo, uint hi) { return metal::clamp(x, uint2(lo), uint2(hi)); }\ninline uint3 M_min(uint3 a, uint b) { return metal::min(a, uint3(b)); }\ninline uint3 M_max(uint3 a, uint b) { return metal::max(a, uint3(b)); }\ninline uint3 M_clamp(uint3 x, uint lo, uint hi) { return metal::clamp(x, uint3(lo), uint3(hi)); }\ninline uint4 M_min(uint4 a, uint b) { return metal::min(a, uint4(b)); }\ninline uint4 M_max(uint4 a, uint b) { return metal::max(a, uint4(b)); }\ninline uint4 M_clamp(uint4 x, uint lo, uint hi) { return metal::clamp(x, uint4(lo), uint4(hi)); }\ntemplate <typename T> inline T M_smoothstep(T a, T b, T x) { T t = metal::clamp((x - a) / (b - a), T(0), T(1)); return t * t * (T(3) - T(2) * t); }\ninline float2 M_smoothstep(float a, float b, float2 x) { return M_smoothstep(float2(a), float2(b), x); }\ninline float3 M_smoothstep(float a, float b, float3 x) { return M_smoothstep(float3(a), float3(b), x); }\ninline float4 M_smoothstep(float a, float b, float4 x) { return M_smoothstep(float4(a), float4(b), x); }\n\ntemplate <typename T> inline T M_radians(T d) { return d * 0.017453292519943