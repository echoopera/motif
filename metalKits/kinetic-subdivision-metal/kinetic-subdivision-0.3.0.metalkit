.0, id = 0.0;\n  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {\n    float2 g = float2(float(i), float(j)); float2 h = h22(n + g);\n    float2 o = 0.5 + jit * (h - 0.5) + amp * lc(k, h.x) * 0.5 * (0.5 + h.y);\n    float d = length(g + o - f);\n    if (d < d1) { d2 = d1; d1 = d; id = h.x; } else if (d < d2) d2 = d;\n  }\n  return float3(d1, d2, id);\n}\nfloat sdSeg(float2 p, float2 a, float2 b) { float2 pa = p - a, ba = b - a; float h = sat(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }\nfloat sdBox(float2 p, float2 b) { float2 d = abs(p) - b; return length(M_max(d, 0.0)) + M_min(M_max(d.x, d.y), 0.0); }\nfloat sdBox3(float3 p, float3 b) { float3 q = abs(p) - b; return length(M_max(q, 0.0)) + M_min(M_max(q.x, M_max(q.y, q.z)), 0.0); }\nfloat sdTorus(float3 p, float2 t) { float2 q = float2(length(p.xz) - t.x, p.y); return length(q) - t.y; }\nfloat glowd(float d, float w) { return w / (abs(d) + w); }\nfloat glow2(float d, float w) { float x = d / w; return 1.0 / (1.0 + x * x); }\nfloat gauss1(float d, float w) { return exp(-d * d / (w * w)); }\nfloat line(float d, float w) { return 1.0 - M_smoothstep(w * 0.5, w * 0.5 + 1.5 / M_min(u_res.x, u_res.y), d); }\nfloat aa() { return 1.5 / M_min(u_res.x, u_res.y); }\nfloat3 ramp(float t) { \n  t = sat(t) * 4.0;\n  if (t < 1.0) return M_mix(u_bg, u_a2, t);\n  if (t < 2.0) return M_mix(u_a2, u_a0, t - 1.0);\n  if (t < 3.0) return M_mix(u_a0, u_a1, t - 2.0);\n  return M_mix(u_a1, u_ink, t - 3.0);\n}\nfloat3 accent(float i) { float j = M_mod(floor(i), 3.0); return j < 0.5 ? u_a0 : j < 1.5 ? u_a1 : u_a2; }\nfloat3 hot(float t) { t = M_max(t, 0.0); return M_mix(u_a2, u_a0, sat(t * 1.4)) * sat(t * 3.0) + u_ink * M_max(t - 0.6, 0.0) * 1.2 + u_a1 * sat(t - 1.0) * 0.5; }\nfloat3 aces(float3 x) { return sat((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)); }\nfloat3 bb(float T) { \n  T = M_clamp(T, 1000.0, 40000.0) / 100.0; float3 c;\n  c.r = T <= 66.0 ? 1.0 : sat(1.2929 * pow(T - 60.0, -0.1332));\n  c.g = T <= 66.0 ? sat(0.3901 * log(T) - 0.6318) : sat(1.1298 * pow(T - 60.0, -0.0755));\n  c.b = T >= 66.0 ? 1.0 : (T <= 19.0 ? 0.0 : sat(0.5432 * log(T - 10.0) - 1.1963));\n  return c * c;\n}\nfloat4 emit(float3 c) { c = M_max(c, 0.0); return float4(c, M_max(c.r, M_max(c.g, c.b))); }\nfloat4 solid(float3 c, float a) { return float4(c * a, a); }\nfloat4 over(float4 top, float4 base) { return top + base * (1.0 - top.a); }\nfloat4 addc(float4 a, float4 b) { return float4(a.rgb + b.rgb, M_max(a.a, b.a)); }\nfloat M_rate(float n) { n = M_max(0.0, floor(n + 0.5)); return u_safe > 0.5 ? M_min(n, floor(3.0 * u_L)) : n; }\nfloat tslot(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : floor(fract(u_p) * r); }\nfloat tfrac(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : fract(fract(u_p) * r); }\nfloat safeCycles(float k) { return M_rate(k); }\nfloat strobe(float k, float duty) { float r = M_rate(k); if (r < 1.0) return duty; float f = fract(u_p * r); float soft = u_safe > 0.5 ? 0.18 : 0.02; return M_smoothstep(0.0, soft, f) * (1.0 - M_smoothstep(duty, duty + soft, f)); }\nfloat flashAmt(float x) { return u_safe > 0.5 ? x * 0.35 : x; }\nfloat pulse(float s, float k, float ph, float wd) { float x = fract(s - k * u_p - ph); return exp(-x * x / (wd * wd)) + exp(-(1.0 - x) * (1.0 - x) / (wd * wd)); }\nfloat growEnv(float h) { float x = fract(u_p); float a = (1.0 - h) * 0.5; return M_smoothstep(0.0, a, x) * (1.0 - M_smoothstep(1.0 - a * 0.6, 1.0, x)); }\nfloat2 M_uv(float2 fc) { return (fc - 0.5 * u_res) / M_min(u_res.x, u_res.y); }\nfloat2 M_asp() { return u_res / M_min(u_res.x, u_res.y); }\nfloat4 buf(MTex b, float2 fc) { return M_tex(b, fc / u_res); }\nint p_variant;\nint p_depth;\nint p_rate;\nfloat p_smoothness;\nfloat p_amount;\nfloat p_edge;\nfloat p_smear;\nfloat p_ink;\nfloat p_imageMix;\nint p_topologyHold;\nint p_splitDirection;\nint p_cellScale;\nint p_motionCharacter;\nint p_sourceSampling;\nint p_edgeLanguage;\nfloat p_focalProtection;\nfloat p_splitBias;\nint p_displacementAxis;\nfloat p_focalPointX;\nfloat p_focalPointY;\nfloat p_edgeTintR;\nfloat p_edgeTintG;\nfloat p_edgeTintB;\nfloat p_echoLength;\nfloat p_colorSeparation;\nfloat2 v_focalPoint() { return float2(p_focalPointX, p_focalPointY); }\nfloat3 s_edgeTint() { return float3(p_edgeTintR, p_edgeTintG, p_edgeTintB); }\nfloat3 c_edgeTint() { float3 c = s_edgeTint(); return M_mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), M_step(float3(0.04045), c)); }\nMTex u_source;\nfloat u_sourceOn;\nfloat2 u_sourceSize;\nfloat u_sourceTime;\nfloat4 m_source(float2 q) { return M_tex(u_source, M_clamp(q, float2(0.0), float2(1.0))); }\nfloat4 m_sourcePx(float2 fc) { return m_source(fc / u_res); }\nfloat4 m_sourceUV(float2 uv) { return m_source(uv * M_min(u_res.x, u_res.y) / u_res + 0.5); }\nfloat4 K_source(float2 q) {\n q=M_clamp(q,float2(0.0),float2(1.0));\n float4 fallback=M_tex(u_buf0,q);\n float4 media=m_source(q);\n float3 opaqueMedia=media.rgb+u_bg*(1.0-media.a);\n return float4(M_mix(fallback.rgb,opaqueMedia,u_sourceOn*p_imageMix),1.0);\n}\nfloat K_edge(float d, float w) {return 1.0-M_smoothstep(w*0.35,w*1.6,d);}\nfloat4 motif(float2 uv, float2 fc) {\n float2 q=fc/u_res;\n float4 map=M_tex(u_buf1,q);\n float id=map.r,dist=map.g*12.0;\n float2 off=(map.ba-0.5)*2.0*p_amount;\n float focal=(1.0-M_smoothstep(0.08,0.34,length(uv-v_focalPoint())))*p_focalProtection;\n if(p_displacementAxis==1)off.y=0.0;\n else if(p_displacementAxis==2)off.x=0.0;\n else if(p_displacementAxis==3){float2 dir=normalize(uv-v_focalPoint()+float2(0.0001));off=dir*dot(off,dir);}\n off*=1.0-focal;\n float border=K_edge(dist,p_edge);\n if(p_edgeLanguage==1)border=K_edge(dist,p_edge*2.8);\n else if(p_edgeLanguage==2)border=M_max(border,K_edge(abs(dist-3.3),p_edge*0.7));\n else if(p_edgeLanguage==3)border*=M_step(0.83,h21(floor(fc/float2(11.0))+floor(id*100.0)));\n else if(p_edgeLanguage==4)border=0.0;\n float3 edgeColor=p_edgeLanguage==1?u_bg:c_edgeTint();\n float2 sq=M_clamp(q+off*float2(1.4,1.0),float2(0.0),float2(1.0));\n if(p_sourceSampling==1)sq.x=floor(sq.x*55.0)/55.0;\n else if(p_sourceSampling==2)sq.x=M_mix(sq.x,h11(floor(id*255.0)+17.0),0.75);\n else if(p_sourceSampling==3&&id>0.5)sq.x=1.0-sq.x;\n float3 src=K_source(sq).rgb;\n float3 col=src;\n float ink=p_ink;\n if(p_variant==0){ \n   col=M_mix(src,edgeColor,border*ink);\n }else if(p_variant==1){ \n   float seam=K_edge(dist,p_edge*2.7);\n   float accent=M_step(0.87,h11(floor(id*255.0)+5.0));\n   col=M_mix(src,u_bg,seam*0.96);\n   col=M_mix(col,u_a0,accent*0.26*(1.0-seam));\n }else if(p_variant==2){ \n   float band=M_step(0.77,h11(floor(id*255.0)+13.0));\n   float2 bq=float2(M_mix(sq.x,floor(sq.x*150.0)/150.0,band*0.9),sq.y);\n   col=K_source(bq).rgb;\n   col=M_mix(col,u_bg,M_step(0.96,h11(floor(id*255.0)+41.0))*0.79);\n   col=M_mix(col,edgeColor,border*ink*0.65);\n }else if(p_variant==3){ \n   float scan=0.94+0.06*sin(fc.y*PI);\n   col=src*scan;\n   col=M_mix(col,u_a0,M_step(0.88,h11(floor(id*255.0)+17.0))*0.22);\n   col=M_mix(col,edgeColor,border*ink*0.7);\n }else if(p_variant==4){ \n   float shift=(0.004+p_smear*0.024)*p_colorSeparation;\n   float3 r=K_source(sq+float2(shift,0.0)).rgb;\n   float3 b=K_source(sq-float2(shift,0.0)).rgb;\n   col=float3(r.r,src.g,b.b);\n   col=M_mix(col,edgeColor,border*ink*0.65);\n }else if(p_variant==5){ \n   float dark=M_step(0.83,h11(floor(id*255.0)+53.0));\n   col=M_mix(src,u_bg,dark*0.97);\n   col=M_mix(col,edgeColor,border*ink*0.8);\n }else if(p_variant==6){ \n   float grey=luma(src);\n   float3 duotone=M_mix(u_bg,u_a0,M_smoothstep(0.08,0.95,grey));\n   col=M_mix(src,duotone,0.52);\n   col=M_mix(col,u_bg,border*ink);\n }else if(p_variant==7){ \n   float2 smearQ=float2(M_mix(sq.x,floor(sq.x*105.0)/105.0,p_smear*0.8),sq.y);\n   col=K_source(smearQ).rgb*(0.94+0.06*sin(fc.y*2.0*PI));\n   col=M_mix(col,u_a0,M_step(0.9,h11(floor(id*255.0)+71.0))*0.3);\n   col=M_mix(col,edgeColor,border*ink*0.75);\n }else if(p_variant==8){ \n   col=M_mix(src,edgeColor,border*ink);\n 