eturn as_type<float3>(x); }\ninline float4 uintBitsToFloat(uint4 x)  { return as_type<float4>(x); }\ninline float  intBitsToFloat(int x)     { return as_type<float>(x); }\n\n// ---- hoisted: macros, structs, program-scope constants ---------------------------------------------------------\n#define TAU 6.283185307179586\n#define PI 3.141592653589793\n#define M_PH (u_p * TAU)\n#define SPLIT_DIRECTION_AUTO 0\n#define SPLIT_DIRECTION_HORIZONTAL 1\n#define SPLIT_DIRECTION_VERTICAL 2\n#define SPLIT_DIRECTION_ALTERNATING 3\n#define CELL_SCALE_ANCHORS 0\n#define CELL_SCALE_BALANCED 1\n#define CELL_SCALE_FRAGMENTS 2\n#define MOTION_CHARACTER_GLIDE 0\n#define MOTION_CHARACTER_SPRING 1\n#define MOTION_CHARACTER_STEPS 2\n#define MOTION_CHARACTER_SHUTTER 3\n#define SOURCE_SAMPLING_INTACT 0\n#define SOURCE_SAMPLING_STRETCH 1\n#define SOURCE_SAMPLING_SCANLINE 2\n#define SOURCE_SAMPLING_MIRROR 3\n#define EDGE_LANGUAGE_HAIRLINE 0\n#define EDGE_LANGUAGE_GUTTER 1\n#define EDGE_LANGUAGE_DOUBLE 2\n#define EDGE_LANGUAGE_TICKS 3\n#define EDGE_LANGUAGE_NONE 4\n#define DISPLACEMENT_AXIS_BOTH 0\n#define DISPLACEMENT_AXIS_HORIZONTAL 1\n#define DISPLACEMENT_AXIS_VERTICAL 2\n#define DISPLACEMENT_AXIS_RADIAL 3\n\n// ---- pass: every function is a member so uniforms read as plain identifiers --------------------------------------\nstruct MPass_kinetic_subdivision_survey_grid_p1 {\nfloat2 u_res;\nfloat u_p;\nfloat u_L;\nfloat u_seed;\nfloat u_safe;\nfloat3 u_bg, u_ink, u_a0, u_a1, u_a2;\nMTex u_buf0, u_buf1, u_buf2, u_buf3;\nuint M_pcg(uint v) { uint s = v * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }\nuint M_seedU() { return M_pcg(uint(u_seed) * 2654435761u); }\nfloat M_u2f(uint x) { return float(x >> 8u) * (1.0 / 16777216.0); }\nfloat h11(float x) { return M_u2f(M_pcg(floatBitsToUint(x + 0.0) ^ M_seedU())); }\nfloat h21(float2 p) { return M_u2f(M_pcg(M_pcg(floatBitsToUint(p.x + 0.0) ^ M_seedU()) ^ floatBitsToUint(p.y + 0.0))); }\nfloat