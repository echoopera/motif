 i = M_mod289(i);\n  float4 p = M_perm(M_perm(M_perm(i.z + float4(0.0, i1.z, i2.z, 1.0)) + i.y + float4(0.0, i1.y, i2.y, 1.0)) + i.x + float4(0.0, i1.x, i2.x, 1.0));\n  float n_ = 0.142857142857; float3 ns = n_ * D.wyz - D.xzx;\n  float4 j = p - 49.0 * floor(p * ns.z * ns.z); float4 x_ = floor(j * ns.z); float4 y_ = floor(j - 7.0 * x_);\n  float4 x = x_ * ns.x + ns.yyyy; float4 y = y_ * ns.x + ns.yyyy; float4 h = 1.0 - abs(x) - abs(y);\n  float4 b0 = float4(x.xy, y.xy); float4 b1 = float4(x.zw, y.zw);\n  float4 s0 = floor(b0) * 2.0 + 1.0; float4 s1 = floor(b1) * 2.0 + 1.0; float4 sh = -M_step(h, float4(0.0));\n  float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy; float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;\n  float3 p0 = float3(a0.xy, h.x); float3 p1 = float3(a0.zw, h.y); float3 p2 = float3(a1.xy, h.z); float3 p3 = float3(a1.zw, h.w);\n  float4 norm = M_tis(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\n  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n  float4 m = M_max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0); m = m * m;\n  return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));\n}\nfloat4 M_grad4(float j, float4 ip) {\n  const float4 ones = float4(1.0, 1.0, 1.0, -1.0); float4 p, s;\n  p.xyz = floor(fract(float3(j) * ip.xyz) * 7.0) * ip.z - 1.0; p.w = 1.5 - dot(abs(p.xyz), ones.xyz);\n  s = float4(M_lessThan(p, float4(0.0))); p.xyz = p.xyz + (s.xyz * 2.0 - 1.0) * s.www; return p;\n}\nfloat snoise(float4 v) {\n  const float4 C = float4(0.138196601125011, 0.276393202250021, 0.414589803375032, -0.447213595499958);\n  float4 i = floor(v + dot(v, float4(0.309016994374947451))); float4 x0 = v - i + dot(i, C.xxxx);\n  float4 i0; float3 isX = M_step(x0.yzw, x0.xxx); float3 isYZ = M_step(x0.zww, x0.yyz);\n  i0.x = isX.x + isX.y + isX.z; i0.yzw = 1.0 - isX; i0.y += isYZ.x + isYZ.y; i0.zw += 1.0 - isYZ.xy; i0.z += isYZ.z; i0.w += 1.0 - isYZ.z;\n  float4 i3 = M_clamp(i0, 0.0, 1.0); float4 i2 = M_clamp(i0 - 1.0, 0.0, 1.0); float4 i1 = M_clamp(i0 - 2.0, 0.0, 1.0);\n  float4 x1 = x0 - i1 + C.xxxx; float4 x2 = x0 - i2 + C.yyyy; float4 x3 = x0 - i3 + C.zzzz; float4 x4 = x0 + C.wwww;\n  i = M_mod289(i);\n  float j0 = M_perm(M_perm(M_perm(M_perm(i.w) + i.z) + i.y) + i.x);\n  float4 j1 = M_perm(M_perm(M_perm(M_perm(i.w + float4(i1.w, i2.w, i3.w, 1.0)) + i.z + float4(i1.z, i2.z, i3.z, 1.0)) + i.y + float4(i1.y, i2.y, i3.y, 1.0)) + i.x + float4(i1.x, i2.x, i3.x, 1.0));\n  float4 ip = float4(1.0 / 294.0, 1.0 / 49.0, 1.0 / 7.0, 0.0);\n  float4 p0 = M_grad4(j0, ip); float4 p1 = M_grad4(j1.x, ip); float4 p2 = M_grad4(j1.y, ip); float4 p3 = M_grad4(j1.z, ip); float4 p4 = M_grad4(j1.w, ip);\n  float4 norm = M_tis(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\n  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w; p4 *= M_tis(dot(p4, p4));\n  float3 m0 = M_max(0.6 - float3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0); float2 m1 = M_max(0.6 - float2(dot(x3, x3), dot(x4, x4)), 0.0);\n  m0 = m0 * m0; m1 = m1 * m1;\n  return 49.0 * (dot(m0 * m0, float3(dot(p0, x0), dot(p1, x1), dot(p2, x2))) + dot(m1 * m1, float2(dot(p3, x3), dot(p4, x4))));\n}\nfloat ln2(float2 x, float k, float r) { return snoise(float4(x + M_seedOff(), r * lc(k, 0.0))); }\nfloat ln3(float3 x, float k, float r) { float2 c = r * lc(k, 0.0); return snoise(float4(x.xy + M_seedOff(), x.z + c.x, c.y)); }\nfloat lfbm(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln2(x, k, r); x = m * x + 11.7; a *= 0.5; }\n  return s;\n}\nfloat lfbm3(float3 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5;\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln3(x, k, r); x = x * 2.02 + float3(7.1, 3.3, 1.9); a *= 0.5; }\n  return s;\n}\nfloat lridge(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; float n = 1.0 - abs(ln2(x, k, r)); s += a * n * n; x = m * x + 5.3; a *= 0.5; }\n  return s;\n}\nfloat3 lvoro(float2 x, float jit, float k, float amp) {\n  float2 n = floor(x), f = fract(x); float d1 = 8.0, d2 = 8.0, id = 0.0;\n  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {\n    float2 g = float2(float(i), float(j)); float2 h = h22(n + g);\n    float2 o = 0.5 + jit * (h - 0.5) + amp * lc(k, h.x) * 0.5 * (0.5 + h.y);\n    float d = length(g + o - f);\n    if (d < d1) { d2 = d1; d1 = d; id = h.x; } else if (d < d2) d2 = d;\n  }\n  return float3(d1, d2, id);\n}\nfloat sdSeg(float2 p, float2 a, float2 b) { float2 pa = p - a, ba = b - a; float h = sat(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }\nfloat sdBox(float2 p, float2 b) { float2 d = abs(p) - b; return length(M_max(d, 0.0)) + M_min(M_max(d.x, d.y), 0.0); }\nfloat sdBox3(float3 p, float3 b) { float3 q = abs(p) - b; return length(M_max(q, 0.0)) + M_min(M_max(q.x, M_max(q.y, q.z)), 0.0); }\nfloat sdTorus(float3 p, float2 t) { float2 q = float2(length(p.xz) - t.x, p.y); return length(q) - t.y; }\nfloat glowd(float d, float w) { return w / (abs(d) + w); }\nfloat glow2(float d, float w) { float x = d / w; return 1.0 / (1.0 + x * x); }\nfloat gauss1(float d, float w) { return exp(-d * d / (w * w)); }\nfloat line(float d, float w) { return 1.0 - M_smoothstep(w * 0.5, w * 0.5 + 1.5 / M_min(u_res.x, u_res.y), d); }\nfloat aa() { return 1.5 / M_min(u_res.x, u_res.y); }\nfloat3 ramp(float t) { \n  t = sat(t) * 4.0;\n  if (t < 1.0) return M_mix(u_bg, u_a2, t);\n  if (t < 2.0) return M_mix(u_a2, u_a0, t - 1.0);\n  if (t < 3.0) return M_mix(u_a0, u_a1, t - 2.0);\n  return M_mix(u_a1, u_ink, t - 3.0);\n}\nfloat3 accent(float i) { float j = M_mod(floor(i), 3.0); return j < 0.5 ? u_a0 : j < 1.5 ? u_a1 : u_a2; }\nfloat3 hot(float t) { t = M_max(t, 0.0); return M_mix(u_a2, u_a0, sat(t * 1.4)) * sat(t * 3.0) + u_ink * M_max(t - 0.6, 0.0) * 1.2 + u_a1 * sat(t - 1.0) * 0.5; }\nfloat3 aces(float3 x) { return sat((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)); }\nfloat3 bb(float T) { \n  T = M_clamp(T, 1000.0, 40000.0) / 100.0; float3 c;\n  c.r = T <= 66.0 ? 1.0 : sat(1.2929 * pow(T - 60.0, -0.1332));\n  c.g = T <= 66.0 ? sat(0.3901 * log(T) - 0.6318) : sat(1.1298 * pow(T - 60.0, -0.0755));\n  c.b = T >= 66.0 ? 1.0 : (T <= 19.0 ? 0.0 : sat(0.5432 * log(T - 10.0) - 1.1963));\n  return c * c;\n}\nfloat4 emit(float3 c) { c = M_max(c, 0.0); return float4(c, M_max(c.r, M_max(c.g, c.b))); }\nfloat4 solid(float3 c, float a) { return float4(c * a, a); }\nfloat4 over(float4 top, float4 base) { return top + base * (1.0 - top.a); }\nfloat4 addc(float4 a, float4 b) { return float4(a.rgb + b.rgb, M_max(a.a, b.a)); }\nfloat M_rate(float n) { n = M_max(0.0, floor(n + 0.5)); return u_safe > 0.5 ? M_min(n, floor(3.0 * u_L)) : n; }\nfloat tslot(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : floor(fract(u_p) * r); }\nfloat tfrac(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : fract(fract(u_p) * r); }\nfloat safeCycles(float k) { return M_rate(k); }\nfloat strobe(float k, float duty) { float r = M_rate(k); if (r < 1.0) return duty; float f = fract(u_p * r); float soft = u_safe > 0.5 ? 0.18 : 0.02; return M_smoothstep(0.0, soft, f) * (1.0 - M_smoothstep(duty, duty + soft, f)); }\nfloat flashAmt(float x) { return u_safe > 0.5 ? x * 0.35 : x; }\nfloat pulse(float s, float k, float ph, float wd) { float x = fract(s - k * u_p - ph); return exp(-x * x / (wd * wd)) + exp(-(1.0 - x) * (1.0 - x) / (wd * wd)); }\nfloat growEnv(float h) { float x = fract(u_p); float a = (1.0 - h) * 0.5; return M_smoothstep(0.0, a, x) * (1.0 - M_smoothstep(1.0 - a * 0.6, 1.0, x)); }\nfloat2 M_uv(float2 fc) { return (fc - 0.5 * u_res) / M_min(u_res.x, u_res.y); }\nfloat2 M_asp() { return u_res / M_min(u_res.x, u_res.y); }\nfloat4 buf(MTex b, float2 fc) { return M_tex(b, fc / u_res); }\nint p_variant;\nint p_depth;\nint p_rate;\nfloat p_smoothness;\nfloat p_amount;\nfloat p_edge;\nfloat p_smear;\nfloat p_ink;\nfloat p_imageMix;\nint p_topologyHold;\nint p_splitDirection;\nint p_cellScale;\nint p_motionCharacter;\nint p_sourceSampling;\nint p_edgeLanguage;\nfloat p_focalProtection;\nfloat p_splitBias;\nint p_displacementAxis;\nfloat p_focalPointX;\nfloat p_focalPointY;\nfloat p_edgeTintR;\nfloat p_edgeTintG;\nfloat p_edgeTintB;\nfloat p_echoLength;\nfloat p_colorSeparation;\nfloat2 v_focalPoint() { return float2(p_focalPointX, p_focalPointY); }\nfloat3 s_edgeTint() { return float3(p_edgeTintR, p_edgeTintG, p_edgeTintB); }\nfloat3 c_edgeTint() { float3 c = s_edgeTint(); return M_mix(c / 12.92, pow((c + 0.055) / 1.055, float3(2.4)), M_step(float3(0.04045), c)); }\nMTex u_source;\nfloat u_sourceOn;\nfloat2 u_sourceSize;\nfloat u_sourceTime;\nfloat4 m_source(float2 q) { return M_tex(u_source, M_clamp(q, float2(0.0), float2(1.0))); }\nfloat4 m_sourcePx(float2 fc) { return m_source(fc / u_res); }\nfloat4 m_sourceUV(float2 uv) { return m_source(uv * M_min(u_res.x, u_res.y) / u_res + 0.5); }\nfloat4 K_source(float2 q) {\n q=M_clamp(q,float2(0.0),float2(1.0));\n float4 fallback=M_tex(u_buf0,q);\n float4 media=m_source(q);\n float3 opaqueMedia=media.rgb+u_bg*(1.0-media.a);\n return float4(M_mix(fallback.rgb,opaqueMedia,u_sourceOn*p_imageMix),1.0);\n}\nfloat K_edge(float d, float w) {return 1.0-M_smoothstep(w*0.35,w*1.6,d);}\nfloat4 motif(float2 uv, float2 fc) {\n float2 q=fc/u_res;\n float4 map=M_tex(u_buf1,q);\n float id=map.r,dist=map.g*12.0;\n float2 off=(map.ba-0.5)*2.0*p_amount;\n float focal=(1.0-M_smoothstep(0.08,0.34,length(uv-v_focalPoint())))*p_focalProtection;\n if(p_displacementAxis==1)off.y=0.0;\n else if(p_displacementAxis==2)off.x=0.0;\n else if(p_displacementAxis==3){float2 dir=normalize(uv-v_focalPoint()+float2(0.0001));off=dir*dot(off,dir);}\n off*=1.0-focal;\n float border=K_edge(dist,p_edge);\n if(p_edgeLanguage==1)border=K_edge(dist,p_edge*2.8);\n else if(p_edgeLanguage==2)border=M_max(border,K_edge(abs(dist-3.3),p_edge*0.7));\n else if(p_edgeLanguage==3)border*=M_step(0.83,h21(floor(fc/float2(11.0))+floor(id*100.0)));\n else if(p_edgeLanguage==4)border=0.0;\n float3 edgeColor=p_edgeLanguage==1?u_bg:c_edgeTint();\n float2 sq=M_clamp(q+off*float2(1.4,1.0),float2(0.0),float2(1.0));\n if(p_sourceSampling==1)sq.x=floor(sq.x*55.0)/55.0;\n else if(p_sourceSampling==2)sq.x=M_mix(sq.x,h11(floor(id*255.0)+17.0),0.75);\n else if(p_sourceSampling==3&&id>0.5)sq.x=1.0-sq.x;\n float3 src=K_source(sq).rgb;\n float3 col=src;\n float ink=p_ink;\n if(p_variant==0){ \n   col=M_mix(src,edgeColor,border*ink);\n }else if(p_variant==1){ \n   float seam=K_edge(dist,p_edge*2.7);\n   float accent=M_step(0.87,h11(floor(id*255.0)+5.0));\n   col=M_mix(src,u_bg,seam*0.96);\n   col=M_mix(col,u_a0,accent*0.26*(1.0-seam));\n }else if(p_variant==2){ \n   float band=M_step(0.77,h11(floor(id*255.0)+13.0));\n   float2 bq=float2(M_mix(sq.x,floor(sq.x*150.0)/150.0,band*0.9),sq.y);\n   col=K_source(bq).rgb;\n   col=M_mix(col,u_bg,M_step(0.96,h11(floor(id*255.0)+41.0))*0.79);\n   col=M_mix(col,edgeColor,border*ink*0.65);\n }else if(p_variant==3){ \n   float scan=0.94+0.06*sin(fc.y*PI);\n   col=src*scan;\n   col=M_mix(col,u_a0,M_step(0.88,h11(floor(id*255.0)+17.0))*0.22);\n   col=M_mix(col,edgeColor,border*ink*0.7);\n }else if(p_variant==4){ \n   float shift=(0.004+p_smear*0.024)*p_colorSeparation;\n   float3 r=K_source(sq+float2(shift,0.0)).rgb;\n   float3 b=K_source(sq-float2(shift,0.0)).rgb;\n   col=float3(r.r,src.g,b.b);\n   col=M_mix(col,edgeColor,border*ink*0.65);\n }else if(p_variant==5){ \n   float dark=M_step(0.83,h11(floor(id*255.0)+53.0));\n   col=M_mix(src,u_bg,dark*0.97);\n   col=M_mix(col,edgeColor,border*ink*0.8);\n }else if(p_variant==6){ \n   float grey=luma(src);\n   float3 duotone=M_mix(u_bg,u_a0,M_smoothstep(0.08,0.95,grey));\n   col=M_mix(src,duotone,0.52);\n   col=M_mix(col,u_bg,border*ink);\n }else if(p_variant==7){ \n   float2 smearQ=float2(M_mix(sq.x,floor(sq.x*105.0)/105.0,p_smear*0.8),sq.y);\n   col=K_source(smearQ).rgb*(0.94+0.06*sin(fc.y*2.0*PI));\n   col=M_mix(col,u_a0,M_step(0.9,h11(floor(id*255.0)+71.0))*0.3);\n   col=M_mix(col,edgeColor,border*ink*0.75);\n }else if(p_variant==8){ \n   col=M_mix(src,edgeColor,border*ink);\n   float ticks=M_step(0.985,h21(floor(fc/float2(9.0))+floor(id*100.0)));\n   col=M_mix(col,u_a0,ticks*0.24);\n }else{ \n   float3 echoA=K_source(M_clamp(sq+(off*0.9+float2(0.01,0.0))*p_echoLength,float2(0.0),float2(1.0))).rgb;\n   float3 echoB=K_source(M_clamp(sq-(off*0.45+float2(0.005,0.0))*p_echoLength,float2(0.0),float2(1.0))).rgb;\n   col=M_mix(src,(echoA+echoB)*0.5,0.4);\n   col=M_mix(col,edgeColor,border*ink*0.65);\n }\n \n if(p_variant==0||p_variant==8){float tick=M_step(0.88,h21(floor(fc/float2(12.0))+floor(id*100.0)));col=M_mix(col,u_ink,tick*border*0.2);}\n col=M_mix(col,K_source(q).rgb,focal);\n return float4(M_max(col,float3(0.0)),1.0);\n}\nfloat4 gl_FragCoord;\nfloat M_dither(float2 fc) { return M_u2f(M_pcg(uint(fc.x) * 1973u ^ M_pcg(uint(fc.y) * 9277u))) - 0.5; }\nfloat3 M_srgb(float3 c) { return M_mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, M_step(0.0031308, c)); }\n  MPass_kinetic_subdivision_afterimage_atlas_p2(MTex b0, MTex b1, MTex b2, MTex b3, MTex i0) : u_buf0(b0), u_buf1(b1), u_buf2(b2), u_buf3(b3), u_source(i0) {}\n};\n\n// ---- entry point: pass 2 ----------------------------------------------------------------------------\nfragment float4 mfs_kinetic_subdivision_afterimage_atlas_p2(float4 pos [[position]],\n    constant MotifUniforms& U [[buffer(0)]],\n    constant float* P [[buffer(1)]],\n    texture2d<float> buf0 [[texture(0)]], texture2d<float> buf1 [[texture(1)]],\n    texture2d<float> buf2 [[texture(2)]], texture2d<float> buf3 [[texture(3)]], texture2d<float> in0 [[texture(4)]])\n{\n  MPass_kinetic_subdivision_afterimage_atlas_p2 M(MTex{buf0}, MTex{buf1}, MTex{buf2}, MTex{buf3}, MTex{in0});\n  M.u_res = U.res; M.u_p = U.p; M.u_L = U.L; M.u_seed = U.seed; M.u_safe = U.safe;\n  M.u_bg = U.bg.xyz; M.u_ink = U.ink.xyz; M.u_a0 = U.a0.xyz; M.u_a1 = U.a1.xyz; M.u_a2 = U.a2.xyz;\n  M.u_sourceOn = U.media0.x;\n  M.u_sourceTime = U.media0.y;\n  M.u_sourceSize = U.media0.zw;\n  M.p_variant = int(rint(P[0]));\n  M.p_depth = int(rint(P[1]));\n  M.p_rate = int(rint(P[2]));\n  M.p_smoothness = P[3];\n  M.p_amount = P[4];\n  M.p_edge = P[5];\n  M.p_smear = P[6];\n  M.p_ink = P[7];\n  M.p_imageMix = P[8];\n  M.p_topologyHold = int(rint(P[9]));\n  M.p_splitDirection = int(rint(P[10]));\n  M.p_cellScale = int(rint(P[11]));\n  M.p_motionCharacter = int(rint(P[12]));\n  M.p_sourceSampling = int(rint(P[13]));\n  M.p_edgeLanguage = int(rint(P[14]));\n  M.p_focalProtection = P[15];\n  M.p_splitBias = P[16];\n  M.p_displacementAxis = int(rint(P[17]));\n  M.p_focalPointX = P[18];\n  M.p_focalPointY = P[19];\n  M.p_edgeTintR = P[20];\n  M.p_edgeTintG = P[21];\n  M.p_edgeTintB = P[22];\n  M.p_echoLength = P[23];\n  M.p_colorSeparation = P[24];\n  float2 fc = float2(pos.x, U.res.y - pos.y);     // GL convention: origin bottom-left\n  M.gl_FragCoord = float4(fc, pos.z, pos.w);\n  float4 c = M.motif(M.M_uv(fc), fc);\n  if (any(isnan(c))) c = float4(0.0);\n  if (U.encode < 0.5) return c;\n  c = max(c, float4(0.0));\n  float a = clamp(max(c.a, max(c.r, max(c.g, c.b))), 0.0, 1.0);\n  float3 s = a > 1e-5 ? M_clamp(c.rgb / a, 0.0, 1.0) : float3(0.0);\n  s = M.M_srgb(s) + M.M_dither(fc) / 255.0;\n  return float4(M_clamp(s, 0.0, 1.0) * a, a);\n}\n"}}
