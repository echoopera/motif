= M_min(g.xyz, l.zxy); float3 i2 = M_max(g.xyz, l.zxy);\n  float3 x1 = x0 - i1 + C.xxx; float3 x2 = x0 - i2 + C.yyy; float3 x3 = x0 - D.yyy;\n  i = M_mod289(i);\n  float4 p = M_perm(M_perm(M_perm(i.z + float4(0.0, i1.z, i2.z, 1.0)) + i.y + float4(0.0, i1.y, i2.y, 1.0)) + i.x + float4(0.0, i1.x, i2.x, 1.0));\n  float n_ = 0.142857142857; float3 ns = n_ * D.wyz - D.xzx;\n  float4 j = p - 49.0 * floor(p * ns.z * ns.z); float4 x_ = floor(j * ns.z); float4 y_ = floor(j - 7.0 * x_);\n  float4 x = x_ * ns.x + ns.yyyy; float4 y = y_ * ns.x + ns.yyyy; float4 h = 1.0 - abs(x) - abs(y);\n  float4 b0 = float4(x.xy, y.xy); float4 b1 = float4(x.zw, y.zw);\n  float4 s0 = floor(b0) * 2.0 + 1.0; float4 s1 = floor(b1) * 2.0 + 1.0; float4 sh = -M_step(h, float4(0.0));\n  float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy; float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;\n  float3 p0 = float3(a0.xy, h.x); float3 p1 = float3(a0.zw, h.y); float3 p2 = float3(a1.xy, h.z); float3 p3 = float3(a1.zw, h.w);\n  float4 norm = M_tis(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\n  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n  float4 m = M_max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0); m = m * m;\n  return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));\n}\nfloat4 M_grad4(float j, float4 ip) {\n  const float4 ones = float4(1.0, 1.0, 1.0, -1.0); float4 p, s;\n  p.xyz = floor(fract(float3(j) * ip.xyz) * 7.0) * ip.z - 1.0; p.w = 1.5 - dot(abs(p.xyz), ones.xyz);\n  s = float4(M_lessThan(p, float4(0.0))); p.xyz = p.xyz + (s.xyz * 2.0 - 1.0) * s.www; return p;\n}\nfloat snoise(float4 v) {\n  const float4 C = float4(0.138196601125011, 0.276393202250021, 0.414589803375032, -0.447213595499958);\n  float4 i = floor(v + dot(v, float4(0.309016994374947451))); float4 x0 = v - i + dot(i, C.xxxx);\n  float4 i0; float3 isX = M_step(x0.yzw, x0.xxx); float3 isYZ = M_step(x0.zww, x0.yyz);\n  i0.x = isX.x + isX.y + isX.z; i0.yzw = 1.0 - isX; i0.y += isYZ.x + isYZ.y; i0.zw += 1.0 - isYZ.xy; i0.z += isYZ.z; i0.w += 1.0 - isYZ.z;\n  float4 i3 = M_clamp(i0, 0.0, 1.0); float4 i2 = M_clamp(i0 - 1.0, 0.0, 1.0); float4 i1 = M_clamp(i0 - 2.0, 0.0, 1.0);\n  float4 x1 = x0 - i1 + C.xxxx; float4 x2 = x0 - i2 + C.yyyy; float4 x3 = x0 - i3 + C.zzzz; float4 x4 = x0 + C.wwww;\n  i = M_mod289(i);\n  float j0 = M_perm(M_perm(M_perm(M_perm(i.w) + i.z) + i.y) + i.x);\n  float4 j1 = M_perm(M_perm(M_perm(M_perm(i.w + float4(i1.w, i2.w, i3.w, 1.0)) + i.z + float4(i1.z, i2.z, i3.z, 1.0)) + i.y + float4(i1.y, i2.y, i3.y, 1.0)) + i.x + float4(i1.x, i2.x, i3.x, 1.0));\n  float4 ip = float4(1.0 / 294.0, 1.0 / 49.0, 1.0 / 7.0, 0.0);\n  float4 p0 = M_grad4(j0, ip); float4 p1 = M_grad4(j1.x, ip); float4 p2 = M_grad4(j1.y, ip); float4 p3 = M_grad4(j1.z, ip); float4 p4 = M_grad4(j1.w, ip);\n  float4 norm = M_tis(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\n  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w; p4 *= M_tis(dot(p4, p4));\n  float3 m0 = M_max(0.6 - float3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0); float2 m1 = M_max(0.6 - float2(dot(x3, x3), dot(x4, x4)), 0.0);\n  m0 = m0 * m0; m1 = m1 * m1;\n  return 49.0 * (dot(m0 * m0, float3(dot(p0, x0), dot(p1, x1), dot(p2, x2))) + dot(m1 * m1, float2(dot(p3, x3), dot(p4, x4))));\n}\nfloat ln2(float2 x, float k, float r) { return snoise(float4(x + M_seedOff(), r * lc(k, 0.0))); }\nfloat ln3(float3 x, float k, float r) { float2 c = r * lc(k, 0.0); return snoise(float4(x.xy + M_seedOff(), x.z + c.x, c.y)); }\nfloat lfbm(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln2(x, k, r); x = m * x + 11.7; a *= 0.5; }\n  return s;\n}\nfloat lfbm3(float3 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5;\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln3(x, k, r); x = x * 2.02 + float3(7.1, 3.3, 1.9); a *= 0.5; }\n  return s;\n}\nfloat lridge(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; float n = 1.0 - abs(ln2(x, k, r)); s += a * n * n; x = m * x + 5.3; a *= 0.5; }\n  return s;\n}\nfloat3 lvoro(float2 x, float jit, float k, float amp) {\n  float2 n = floor(x), f = fract(x); float d1 = 8.0, d2 = 8.0, id = 0.0;\n  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {\n    float2 g = float2(float(i), float(j)); float2 h = h22(n + g);\n    float2 o = 0.5 + jit * (h - 0.5) + amp * lc(k, h.x) * 0.5 * (0.5 + h.y);\n    float d = length(g + o - f);\n    if (d < d1) { d2 = d1; d1 = d; id = h.x; } else if (d < d2) d2 = d;\n  }\n  return float3(d1, d2, id);\n}\nfloat sdSeg(float2 p, float2 a, float2 b) { float2 pa = p - a, ba = b - a; float h = sat(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }\nfloat sdBox(float2 p, float2 b) { float2 d = abs(p) - b; return length(M_max(d, 0.0)) + M_min(M_max(d.x, d.y), 0.0); }\nfloat sdBox3(float3 p, float3 b) { float3 q = abs(p) - b; return length(M_max(q, 0.0)) + M_min(M_max(q.x, M_max(q.y, q.z)), 0.0); }\nfloat sdTorus(float3 p, float2 t) { float2 q = float2(length(p.xz) - t.x, p.y); return length(q) - t.y; }\nfloat glowd(float d, float w) { return w / (abs(d) + w); }\nfloat glow2(float d, float w) { float x = d / w; return 1.0 / (1.0 + x * x); }\nfloat gauss1(float d, float w) { return exp(-d * d / (w * w)); }\nfloat line(float d, float w) { return 1.0 - M_smoothstep(w * 0.5, w * 0.5 + 1.5 / M_min(u_res.x, u_res.y), d); }\nfloat aa() { return 1.5 / M_min(u_res.x, u_res.y); }\nfloat3 ramp(float t) { \n  t = sat(t) * 4.0;\n  if (t < 1.0) return M_mix(u_bg, u_a2, t);\n  if (t < 2.0) return M_mix(u_a2, u_a0, t - 1.0);\n  if (t < 3.0) return M_mix(u_a0, u_a1, t - 2.0);\n  return M_mix(u_a1, u_ink, t - 3.0);\n}\nfloat3 accent(float i) { float j = M_mod(floor(i), 3.0); return j < 0.5 ? u_a0 : j < 1.5 ? u_a