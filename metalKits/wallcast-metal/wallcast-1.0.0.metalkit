x(col*p_exposure*(1.0-p_vignette*0.6*v),float3(0.0));\n}\nfloat4 motif(float2 uv, float2 fc) {\n  float2 q=fc/u_res,A=M_asp();\n  float k=W_drive();\n  float d=length(uv)/length(A*0.5);\n  float amt=p_split*(0.25+1.4*k)*(0.35+d*1.8);\n  float2 dir=normalize(uv+float2(1e-4))/A;\n  float3 col=float3(W_src(q+dir*amt).r,W_src(q).g,W_src(q-dir*amt).b);\n  if(p_spectral){\n    float3 acc=float3(0.0);\n    for(int i=0;i<7;i++){\n      float t=float(i)/6.0;\n      float3 w=0.5+0.5*cos(TAU*(t+float3(0.0,0.33,0.67)));\n      acc+=W_src(q+dir*amt*(t*2.0-1.0)*1.4)*w;\n    }\n    col=M_mix(col,acc*2.0/7.0,0.4);\n  }\n  float3 st=float3(0.0);\n  float len=p_streakLen*(0.4+0.6*M_min(k,1.0));\n  for(int i=-12;i<=12;i++){\n    float x=float(i)/12.0;\n    float3 s=M_max(W_src(q+float2(x*len,0.0))-0.25,float3(0.0));\n    st+=s*exp(-abs(x)*3.5);\n  }\n  st/=8.0;\n  col+=st*u_a0*1.6*p_streak*(0.7+1.3*k);\n  col+=st.bgr*u_a1*0.8*p_streak*p_streakCool;\n  if(safeCycles(float(p_sweeps))>=1.0){\n    float c=lsaw(safeCycles(float(p_sweeps)),0.0);\n    col+=u_a0*0.35*exp(-abs(q.x-c)*40.0)*sin(PI*c);\n  }\n  col=W_finish(col,uv)+W_hud(uv);\n  return float4(col,1.0);\n}\nfloat4 gl_FragCoord;\nfloat M_dither(float2 fc) { return M_u2f(M_pcg(uint(fc.x) * 1973u ^ M_pcg(uint(fc.y) * 9277u))) - 0.5; }\nfloat3 M_srgb(float3 c) { return M_mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, M_step(0.0031308, c)); }\n  MPass_wallcast_prism_split_p1(MTex b0, MTex b1, MTex b2, MTex b3, MTex i0) : u_buf0(b0), u_buf1(b1), u_buf2(b2), u_buf3(b3), u_source(i0) {}\n};\n\n// ---- entry point: pass 1 ----------------------------------------------------------------------------\nfragment float4 mfs_wallcast_prism_split_p1(float4 pos [[position]],\n    constant MotifUniforms& U [[buffer(0)]],\n    constant float* P [[buffer(1)]],\n    texture2d<float> buf0 [[texture(0)]], texture2d<float> buf1 [[texture(1)]],\n    texture2d<float> buf2 [[texture(2)]], texture2d<float> buf3 [[texture(3)]], texture2d<float> in0 