.xyz);\n  s = float4(M_lessThan(p, float4(0.0))); p.xyz = p.xyz + (s.xyz * 2.0 - 1.0) * s.www; return p;\n}\nfloat snoise(float4 v) {\n  const float4 C = float4(0.138196601125011, 0.276393202250021, 0.414589803375032, -0.447213595499958);\n  float4 i = floor(v + dot(v, float4(0.309016994374947451))); float4 x0 = v - i + dot(i, C.xxxx);\n  float4 i0; float3 isX = M_step(x0.yzw, x0.xxx); float3 isYZ = M_step(x0.zww, x0.yyz);\n  i0.x = isX.x + isX.y + isX.z; i0.yzw = 1.0 - isX; i0.y += isYZ.x + isYZ.y; i0.zw += 1.0 - isYZ.xy; i0.z += isYZ.z; i0.w += 1.0 - isYZ.z;\n  float4 i3 = M_clamp(i0, 0.0, 1.0); float4 i2 = M_clamp(i0 - 1.0, 0.0, 1.0); float4 i1 = M_clamp(i0 - 2.0, 0.0, 1.0);\n  float4 x1 = x0 - i1 + C.xxxx; float4 x2 = x0 - i2 + C.yyyy; float4 x3 = x0 - i3 + C.zzzz; float4 x4 = x0 + C.wwww;\n  i = M_mod289(i);\n  float j0 = M_perm(M_perm(M_perm(M_perm(i.w) + i.z) + i.y) + i.x);\n  float4 j1 = M_perm(M_perm(M_perm(M_perm(i.w + float4(i1.w, i2.w, i3.w, 1.0)) + i.z + float4(i1.z, i2.z, i3.z, 1.0)) + i.y + float4(i1.y, i2.y, i3.y, 1.0)) + i.x + float4(i1.x, i2.x, i3.x, 1.0));\n  float4 ip = float4(1.0 / 294.0, 1.0 / 49.0, 1.0 / 7.0, 0.0);\n  float4 p0 = M_grad4(j0, ip); float4 p1 = M_grad4(j1.x, ip); float4 p2 = M_grad4(j1.y, ip); float4 p3 = M_grad4(j1.z, ip); float4 p4 = M_grad4(j1.w, ip);\n  float4 norm = M_tis(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\n  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w; p4 *= M_tis(dot(p4, p4));\n  float3 m0 = M_max(0.6 - float3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0); float2 m1 = M_max(0.6 - float2(dot(x3, x3), dot(x4, x4)), 0.0);\n  m0 = m0 * m0; m1 = m1 * m1;\n  return 49.0 * (dot(m0 * m0, float3(dot(p0, x0), dot(p1, x1), dot(p2, x2))) + dot(m1 * m1, float2(dot(p3, x3), dot(p4, x4))));\n}\nfloat ln2(float2 x, float k, float r) { return snoise(float4(x + M_seedOff(), r * lc(k, 0.0))); }\nfloat ln3(float3 x, float k, float r) { float2 c = r * lc(k, 0.0); return snoise(float4(x.xy + M_seedOff(), x.z + c.x, c.y)); }\nfloat lfbm(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln2(x, k, r); x = m * x + 11.7; a *= 0.5; }\n  return s;\n}\nfloat lfbm3(float3 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5;\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln3(x, k, r); x = x * 2.02 + float3(7.1, 3.3, 1.9); a *= 0.5; }\n  return s;\n}\nfloat lridge(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; float n = 1.0 - abs(ln2(x, k, r)); s += a * n * n; x = m * x + 5.3; a *= 0.5; }\n  return s;\n}\nfloat3 lvoro(float2 x, float jit, float k, float amp) {\n  float2 n = floor(x), f = fract(x); float d1 = 8.0, d2 = 8.0, id = 0.0;\n  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {\n    float2 g = float2(float(i), float(j)); float2 h = h22(n + g);\n    float2 o = 0.5 + jit * (h - 0.5) + amp * lc(k, h.x) * 0.5 * (0.5 + h.y);\n    float d = length(g + o - f);\n    if (d < d1) { d2 = d1; d1 = d; id = h.x; } else if (d < d2) d2 = d;\n  }\n  return float3(d1, d2, id);\n}\nfloat sdSeg(float2 p, float2 a, float2 b) { float2 pa = p - a, ba = b - a; float h = sat(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }\nfloat sdBox(float2 p, float2 b) { float2 d = abs(p) - b; return length(M_max(d, 0.0)) + M_min(M_max(d.x, d.y), 0.0); }\nfloat sdBox3(float3 p, float3 b) { float3 q = abs(p) - b; return length(M_max(q, 0.0)) + M_min(M_max(q.x, M_max(q.y, q.z)), 0.0); }\nfloat sdTorus(float3 p, float2 t) { float2 q = float2(length(p.xz) - t.x, p.y); return length(q) - t.y; }\nfloat glowd(float d, float w) { return w / (abs(d) + w); }\nfloat glow2(float d, float w) { float x = d / w; return 1.0 / (1.0 + x * x); }\nfloat gauss1(float d, float w) { return exp(-d * d / (w * w)); }\nfloat line(float d, float w) { return 1.0 - M_smoothstep(w * 0.5, w * 0.5 + 1.5 / M_min(u_res.x, u_res.y), d); }\nfloat aa() { return 1.5 / M_min(u_res.x, u_res.y); }\nfloat3 ramp(float t) { \n  t = sat(t) * 4.0;\n  if (t < 1.0) return M_mix(u_bg, u_a2, t);\n  if (t < 2.0) return M_mix(u_a2, u_a0, t - 1.0);\n  if (t < 3.0) return M_mix(u_a0, u_a1, t - 2.0);\n  return M_mix(u_a1, u_ink, t - 3.0);\n}\nfloat3 accent(float i) { float j = M_mod(floor(i), 3.0); return j < 0.5 ? u_a0 : j < 1.5 ? u_a1 : u_a2; }\nfloat3 hot(float t) { t = M_max(t, 0.0); return M_mix(u_a2, u_a0, sat(t * 1.4)) * sat(t * 3.0) + u_ink * M_max(t - 0.6, 0.0) * 1.2 + u_a1 * sat(t - 1.0) * 0.5; }\nfloat3 aces(float3 x) { return sat((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)); }\nfloat3 bb(float T) { \n  T = M_clamp(T, 1000.0, 40000.0) / 100.0; float3 c;\n  c.r = T <= 66.0 ? 1.0 : sat(1.2929 * pow(T - 60.0, -0.1332));\n  c.g = T <= 66.0 ? sat(0.3901 * log(T) - 0.6318) : sat(1.1298 * pow(T - 60.0, -0.0755));\n  c.b = T >= 66.0 ? 1.0 : (T <= 19.0 ? 0.0 : sat(0.5432 * log(T - 10.0) - 1.1963));\n  return c * c;\n}\nfloat4 emit(float3 c) { c = M_max(c, 0.0); return float4(c, M_max(c.r, M_max(c.g, c.b))); }\nfloat4 solid(float3 c, float a) { return float4(c * a, a); }\nfloat4 over(float4 top, float4 base) { return top + base * (1.0 - top.a); }\nfloat4 addc(float4 a, float4 b) { return float4(a.rgb + b.rgb, M_max(a.a, b.a)); }\nfloat M_rate(float n) { n = M_max(0.0, floor(n + 0.5)); return u_safe > 0.5 ? M_min(n, floor(3.0 * u_L)) : n; }\nfloat tslot(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : floor(fract(u_p) * r); }\nfloat tfrac(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : fract(fract(u_p) * r); }\nfloat safeCycles(float k) { return M_rate(k); }\nfloat strobe(float k, float duty) { float r = M_rate(k); if (r < 1.0) return duty; float f = fract(u_p * r); float soft = u_safe > 0.5 ? 0.18 : 0.02; return M_smoothstep(0.0, soft, f) * (1.0 - M_smoothstep(duty, duty + soft, f)); }\nfloat flashAmt(float x) { return u_safe > 0.5 ? x * 0.35 : x; }\nfloat pulse(float s, float k, float ph, float wd) { float x = fract(s - k * u_p - ph); return exp(-x * x / (wd * wd)) + exp(-(1.0 - x) * (1.0 - x) / (wd * wd)); }\nfloat growEnv(float h) { float x = fract(u_p); float a = (1.0 - h) * 0.5; return M_smoothstep(0.0, a, x) * (1.0 - M_smoothstep(1.0 - a * 0.6, 1.0, x)); }\nfloat2 M_uv(float2 fc) { return (fc - 0.5 * u_res) / M_min(u_res.x, u_res.y); }\nfloat2 M_asp() { return u_res / M_min(u_res.x, u_res.y); }\nfloat4 buf(MTex b, float2 fc) { return M_tex(b, fc / u_res); }\nint p_cols;\nint p_rain;\nfloat p_flicker;\nfloat p_feed;\nfloat p_contrast;\nint p_tone;\nint p_beats;\nfloat p_hitAmt;\nfloat p_hit;\nfloat p_exposure;\nfloat p_vignette;\nbool p_hud;\nfloat p_readout;\nMTex u_source;\nfloat u_sourceOn;\nfloat2 u_sourceSize;\nfloat u_sourceTime;\nfloat4 m_source(float2 q) { return M_tex(u_source, M_clamp(q, float2(0.0), float2(1.0))); }\nfloat4 m_sourcePx(float2 fc) { return m_source(fc / u_res); }\nfloat4 m_sourceUV(float2 uv) { return m_source(uv * M_min(u_res.x, u_res.y) / u_res + 0.5); }\nfloat3 W_src(float2 q) {\n  q=M_clamp(q,float2(0.0),float2(1.0));\n  if(u_sourceOn>0.5){float4 s=m_source(q);return s.rgb+u_bg*(1.0-s.a);}\n  return M_tex(u_buf0,q).rgb;\n}\nfloat W_beat() {\n  float r=safeCycles(float(p_beats));\n  if(r<1.0) return 0.0;\n  float f=fract(u_p*r);\n  return 1.25*M_smoothstep(0.0,0.04,f)*exp(-f*5.0);\n}\nfloat W_drive() {return M_clamp(W_beat()*p_hitAmt+p_hit,0.0,1.5);}\nfloat W_box(float2 p, float2 c, float2 h) {float2 d=abs(p-c)-h;return M_step(M_max(d.x,d.y),0.0);}\nfloat W_digit(float2 p, int d) {\n  const array<int,10> M=array<int,10>{63,6,91,79,102,109,125,7,127,111};\n  int m=M[M_clamp(d,0,9)];\n  float t=0.09,s=0.0;\n  if((m&1)!=0)  s+=W_box(p,float2(0.5,1.9),float2(0.36,t));\n  if((m&2)!=0)  s+=W_box(p,float2(0.9,1.45),float2(t,0.38));\n  if((m&4)!=0)  s+=W_box(p,float2(0.9,0.55),float2(t,0.38));\n  if((m&8)!=0)  s+=W_box(p,float2(0.5,0.1),float2(0.36,t));\n  if((m&16)!=0) s+=W_box(p,float2(0.1,0.55),float2(t,0.38));\n  if((m&32)!=0) s+=W_box(p,float2(0.1,1.45),float2(t,0.38));\n  if((m&64)!=0) s+=W_box(p,float2(0.5,1.0),float2(0.36,t));\n  return M_min(s,1.0);\n}\nfloat W_num(float2 uv, float2 o, float h, float value, int n) {\n  float2 p=(uv-o)/h*2.0;\n  float adv=1.4,ix=floor(p.x/adv);\n  if(ix<0.0||ix>=float(n)||p.y<0.0||p.y>2.0) return 0.0;\n  float2 lp=float2(p.x-ix*adv,p.y);\n  if(lp.x>1.0) return 0.0;\n  float mx=1.0; for(int i=0;i<4;i++){ if(i>=n) break; mx*=10.0; }\n  float pw=1.0; for(int i=0;i<3;i++){ if(float(i)>=float(n)-1.0-ix) break; pw*=10.0; }\n  float v=floor(M_clamp(value,0.0,mx-1.0)+0.5);\n  return W_digit(lp,int(M_mod(floor(v/pw),10.0)));\n}\nfloat3 W_hud(float2 uv) {\n  if(!p_hud) return float3(0.0);\n  float2 A=M_asp(),e=A*0.5;\n  float m=0.04,th=M_max(aa()*0.8,0.0012),L=0.05;\n  float2 corner=e-float2(m),d=abs(uv)-corner;\n  float br=M_max(M_step(abs(d.y),th)*M_step(-L,d.x)*M_step(d.x,th),M_step(abs(d.x),th)*M_step(-L,d.y)*M_step(d.y,th));\n  float3 col=u_ink*0.85*br;\n  col+=u_a0*1.4*W_num(uv,float2(-corner.x+0.02,-corner.y+0.02),0.032,p_readout,4);\n  float wd=0.17,ht=0.045;\n  float2 t0=float2(corner.x-0.02-wd,-corner.y+0.02);\n  float2 g=(uv-t0)/float2(wd,ht);\n  if(g.x>=0.0&&g.x<=1.0&&g.y>=-0.3&&g.y<=1.4){\n    float env=1.25*M_smoothstep(0.0,0.04,g.x)*exp(-g.x*5.0);\n    float ln=1.0-M_smoothstep(th*0.8,th*1.7,abs(uv.y-(t0.y+env*ht*0.8)));\n    float r=safeCycles(float(p_beats));\n    float ph=r<1.0?0.0:fract(u_p*r);\n    float head=(1.0-M_smoothstep(th*0.6,th*1.5,abs(g.x-ph)*wd))*M_step(0.0,g.y)*M_step(g.y,1.0);\n    col+=u_a1*(ln*1.2+head*0.5);\n  }\n  return col;\n}\nfloat3 W_finish(float3 col, float2 uv) {\n  float2 h=M_asp()*0.5;\n  float v=dot(uv,uv)/dot(h,h);\n  return M_max(col*p_exposure*(1.0-p_vignette*0.6*v),float3(0.0));\n}\nfloat4 motif(float2 uv, float2 fc) {\n  if(u_sourceOn>0.5) return float4(0.0,0.0,0.0,1.0);\n  float2 A=M_asp(),p=uv;\n  float y=p.y,ground=-0.13;\n  float3 col=u_bg*0.8;\n  col+=u_a0*0.16*exp(-abs(y-ground)*4.5);\n  col+=u_a1*0.04*M_smoothstep(-0.1,0.5,y);\n  col+=u_ink*M_step(0.9985,h21(floor(fc/float2(3.0))))*M_step(0.04,y)*0.7;\n  \n  float2 c=float2(A.x*0.12,0.07);\n  float r=length(p-c);\n  float gap=M_smoothstep(0.0,1.0,(c.y-p.y)/0.2);\n  float stripe=(p.y>c.y-0.01)?1.0:M_step(gap*0.75,fract(p.y*30.0));\n  float3 sun=M_mix(u_a2,u_a0,sat((p.y-(c.y-0.2))/0.4));\n  col+=u_a0*0.16*exp(-r*5.0);\n  col=M_mix(col,sun*1.5,(1.0-M_smoothstep(0.2,0.204,r))*stripe);\n  col+=u_a1*0.35*line(abs(r-0.29),0.003);\n  \n  float bw=0.04,x=p.x+A.x*0.5,id=floor(x/bw),fx=fract(x/bw);\n  float top=ground+0.04+0.32*pow(h11(id+3.0),1.6);\n  if(y<top&&y>ground){\n    float3 b=u_bg*0.35+u_a1*0.02;\n    float wy=(y-ground)/0.018;\n    float2 wid=float2(floor(fx*3.0),floor(wy));\n    float lit=M_step(0.62,h21(wid+float2(id*7.0,1.0)));\n    float inner=M_step(0.18,fract(fx*3.0))*M_step(0.25,fract(wy));\n    b+=M_mix(u_a0,u_a2,h21(wid+float2(id,5.0)))*lit*inner*0.9;\n    b+=u_a1*0.3*exp(-(top-y)*260.0);\n    col=b;\n  }\n  \n  if(y<=ground){\n    float dy=ground-y,z=1.0/(dy+0.03);\n    float gx=abs(fract(p.x*z*0.35)-0.5);\n    float vl=1.0-M_smoothstep(0.0,0.05+0.0004*z*z,0.5-gx);\n    float hl=M_smoothstep(0.86,1.0,fract(z*0.7));\n    col=u_bg*0.7+u_a1*0.32*M_max(vl,hl)*M_smoothstep(0.0,0.06,dy)*exp(-dy*2.2);\n    col+=u_a0*0.12*exp(-dy*14.0);\n  }\n  return float4(M_max(col,float3(0.0)),1.0);\n}\nfloat4 gl_FragCoord;\nfloat M_dither(float2 fc) { return M_u2f(M_pcg(uint(fc.x) * 1973u ^ M_pcg(uint(fc.y) * 9277u))) - 0.5; }\nfloat3 M_srgb(float3 c) { return M_mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, M_step(0.0031308, c)); }\n  MPass_wallcast_glyph_mosaic_p0(MTex b0, MTex b1, MTex b2, MTex b3, MTex i0) : u_buf0(b0), u_buf1(b1), u_buf2(b2), u_buf3(b3), u_source(i0) {}\n};\n\n// ---- entry point: pass 0 ----------------------------------------------------------------------------\nfragment float4 mfs_wa