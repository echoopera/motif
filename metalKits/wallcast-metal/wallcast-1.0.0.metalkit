ick band here to drive the effect from audio.","mutate":0},{"key":"exposure","index":9,"type":"range","label":"Exposure","def":1,"min":0.4,"max":1.6,"step":0.01,"unit":"×","group":"Finish","mutate":0.2},{"key":"vignette","index":10,"type":"range","label":"Vignette","def":0.4,"min":0,"max":1,"step":0.01,"group":"Finish","mutate":0.3},{"key":"hud","index":11,"type":"toggle","label":"HUD frame","def":true,"group":"HUD","hint":"Corner brackets, numeric readout and a beat trace.","mutate":0},{"key":"readout","index":12,"type":"range","label":"Readout","def":128,"min":0,"max":9999,"step":1,"group":"HUD","hint":"Shown as four digits. Key it or map a data channel to it.","mutate":0,"show":{"param":"hud","is":true}}]},{"id":"wallcast/shockwave","localId":"shockwave","name":"Shockwave","blurb":"Each kick launches a refractive ring with a colour split. Earlier rings trail and fade.","group":"Optics","tags":["ripple","refraction","kick","edm"],"palette":"magenta","flash":true,"cost":1,"passes":[{"function":"mfs_wallcast_shockwave_p0","source":"wallcast_shockwave_p0","scale":0.5},{"function":"mfs_wallcast_shockwave_p1","source":"wallcast_shockwave_p1","scale":1}],"inputs":[{"id":"source","type":"media","label":"Source","fit":"fill","hint":"Still or clip to treat. Without one, the kit's test image plays."}],"params":[{"key":"originX","index":0,"type":"range","label":"Origin X","def":0,"min":-0.9,"max":0.9,"step":0.0045,"hint":"Where the rings start. Key or map it.","part":{"of":"origin","kind":"point","i":0,"label":"Origin"}},{"key":"originY","index":1,"type":"range","label":"Origin Y","def":0,"min":-0.9,"max":0.9,"step":0.0045,"hint":"Where the rings start. Key or map it.","part":{"of":"origin","kind":"point","i":1,"label":"Origin"}},{"key":"speed","index":2,"type":"range","label":"Ring speed","def":0.42,"min":0.1,"max":1.2,"step":0.01,"mutate":0.5},{"key":"refract","index":3,"type":"range","label":"Refraction","def":0.8,"min":0,"max":1.5,"step":0.01,"mutate":0.6},{"key":"sharp"