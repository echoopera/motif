one_pulse_p1","source":"wallcast_halftone_pulse_p1","scale":1}],"inputs":[{"id":"source","type":"media","label":"Source","fit":"fill","hint":"Still or clip to treat. Without one, the kit's test image plays."}],"params":[{"key":"cells","index":0,"type":"int","label":"Screen cells","def":96,"min":30,"max":200,"step":1,"hint":"Cells across the short side of the frame.","mutate":0.4},{"key":"inkMode","index":1,"type":"select","label":"Ink mode","def":"light","hint":"Light adds RGB dots to the ground. Ink subtracts CMY from paper.","mutate":0.3,"options":[{"v":"light","l":"Light on dark"},{"v":"print","l":"Ink on paper"}]},{"key":"gain","index":2,"type":"range","label":"Dot gain","def":0.72,"min":0.4,"max":1,"step":0.01,"mutate":0.5},{"key":"drift","index":3,"type":"range","label":"Angle drift","def":0.03,"min":0,"max":0.15,"step":0.005,"mutate":0.4},{"key":"registration","index":4,"type":"range","label":"Registration","def":0.25,"min":0,"max":1,"step":0.01,"hint":"Offsets the red and blue screens like a loose print run.","mutate":0.4},{"key":"under","index":5,"type":"range","label":"Source under-print","def":0.05,"min":0,"max":1,"step":0.01,"hint":"Light mode only. Lets the original image show under the dots.","mutate":0.3},{"key":"beats","index":6,"type":"int","label":"Beats / loop","def":4,"min":1,"max":16,"step":1,"group":"Beat","hint":"Kick pulses per loop. The limiter caps this at 3 per second.","mutate":0.3},{"key":"hitAmt","index":7,"type":"range","label":"Beat drive","def":1,"min":0,"max":1.5,"step":0.01,"unit":"×","group":"Beat","hint":"How hard the internal beat drives the effect.","mutate":0.5},{"key":"hit","index":8,"type":"range","label":"Hit","def":0,"min":0,"max":1,"step":0.01,"group":"Beat","hint":"Map a live kick band here to drive the effect from audio.","mutate":0},{"key":"exposure","index":9,"type":"range","label":"Exposure","def":1,"min":0.4,"max":1.6,"step":0.01,"unit":"×","group":"Finish","mutate":0.2},{"key":"vignette","index":10,"type":"range","