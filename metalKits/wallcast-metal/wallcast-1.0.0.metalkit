n  if(g.x>=0.0&&g.x<=1.0&&g.y>=-0.3&&g.y<=1.4){\n    float env=1.25*M_smoothstep(0.0,0.04,g.x)*exp(-g.x*5.0);\n    float ln=1.0-M_smoothstep(th*0.8,th*1.7,abs(uv.y-(t0.y+env*ht*0.8)));\n    float r=safeCycles(float(p_beats));\n    float ph=r<1.0?0.0:fract(u_p*r);\n    float head=(1.0-M_smoothstep(th*0.6,th*1.5,abs(g.x-ph)*wd))*M_step(0.0,g.y)*M_step(g.y,1.0);\n    col+=u_a1*(ln*1.2+head*0.5);\n  }\n  return col;\n}\nfloat3 W_finish(float3 col, float2 uv) {\n  float2 h=M_asp()*0.5;\n  float v=dot(uv,uv)/dot(h,h);\n  return M_max(col*p_exposure*(1.0-p_vignette*0.6*v),float3(0.0));\n}\nfloat4 motif(float2 uv, float2 fc) {\n  if(u_sourceOn>0.5) return float4(0.0,0.0,0.0,1.0);\n  float2 A=M_asp(),p=uv;\n  float y=p.y,ground=-0.13;\n  float3 col=u_bg*0.8;\n  col+=u_a0*0.16*exp(-abs(y-ground)*4.5);\n  col+=u_a1*0.04*M_smoothstep(-0.1,0.5,y);\n  col+=u_ink*M_step(0.9985,h21(floor(fc/float2(3.0))))*M_step(0.04,y)*0.7;\n  \n  float2 c=float2(A.x*0.12,0.07);\n  float r=length(p-c);\n  float gap=M_smoothstep(0.0,1.0,(c.y-p.y)/0.2);\n  float stripe=(p.y>c.y-0.01)?1.0:M_step(gap*0.75,fract(p.y*30.0));\n  float3 sun=M_mix(u_a2,u_a0,sat((p.y-(c.y-0.2))/0.4));\n  col+=u_a0*0.16*exp(-r*5.0);\n  col=M_mix(col,sun*1.5,(1.0-M_smoothstep(0.2,0.204,r))*stripe);\n  col+=u_a1*0.35*line(abs(r-0.29),0.003);\n  \n  float bw=0.04,x=p.x+A.x*0.5,id=floor(x/bw),fx=fract(x/bw);\n  float top=ground+0.04+0.32*pow(h11(id+3.0),1.6);\n  if(y<top&&y>ground){\n    float3 b=u_bg*0.35+u_a1*0.02;\n    float wy=(y-ground)/0.018;\n    float2 wid=float2(floor(fx*3.0),floor(wy));\n    float lit=M_step(0.62,h21(wid+float2(id*7.0,1.0)));\n    float inner=M_step(0.18,fract(fx*3.0))*M_step(0.25,fract(wy));\n    b+=M_mix(u_a0,u_a2,h21(wid+float2(id,5.0)))*lit*inner*0.9;\n    b+=u_a1*0.3*exp(-(top-y)*260.0);\n    col=b;\n  }\n  \n  if(y<=ground){\n    float dy=ground-y,z=1.0/(dy+0.03);\n    float gx=abs(fract(p.x*z*0.35)-0.5);\n    float vl=1.0-M_smoothstep(0.0,0.05+0.0004*z*z,0.5-gx);\n    float hl=M_smoothstep(0.86,1.0,fract(z*0.7));\n    col=u_bg*0.7+u_a1*0.32*M_max(vl,hl)*M_smoothstep(0.0,0.06,dy)*exp(-dy*2.2);\n    col+=u_a0*0.12*exp(-dy*14.0);\n  }\n  return float4(M_max(col,float3(0.0)),1.0);\n}\nfloat4 gl_FragCoord;\nfloat M_dither(float2 fc) { return M_u2f(M_pcg(uint(fc.x) * 1973u ^ M_pcg(uint(fc.y) * 9277u))) - 0.5; }\nfloat3 M_srgb(float3 c) { return M_mix(c * 12.92, 1.055 * pow(c, float3(1.0 / 2.4)) - 0.055, M_step(0.0031308, c)); }\n  MPass_wallcast_prism_split_p0(MTex b0, MTex b1, MTex b2, MTex b3, MTex i0) : u_buf0(b0), u_buf1(b1), u_buf2(b2), u_buf3(b3), u_source(i0) {}\n};\n\n// ---- entry point: pass 0 ----------------------------------------------------------------------------\nfragment float4 mfs_wallcast_prism_split_p0(float4 pos [[position]],\n    constant MotifUniforms& U [[buffer(0)]],\n    constant float* P [[buffer(1)]],\n    texture2d<float> buf0 [[texture(0)]], texture2d<float> buf1 [[texture(1)]],\n    texture2d<float> buf2 [[texture(2)]], texture2d<float> buf3 [[texture(3)]], texture2d<float> in0 [[texture(4)]])\n{\n  MPass_wallcast_prism_split_p0 M(MTex{buf0}, MTex{buf1}, MTex{buf2}, MTex{buf3}, MTex{in0});\n  M.u_res = U.res; M.u_p = U.p; M.u_L = U.L; M.u_seed = U.seed; M.u_safe = U.safe;\n  M.u_bg = U.bg.xyz; M.u_ink = U.ink.xyz; M.u_a0 = U.a0.xyz; M.u_a1 = U.a1.xyz; M.u_a2 = U.a2.xyz;\n  M.u_sourceOn = U.media0.x;\n  M.u_sourceTime = U.media0.y;\n  M.u_sourceSize = U.media0.zw;\n  M.p_split = P[0];\n  M.p_spectral = P[1] > 0.5;\n  M.p_streak = P[2];\n  M.p_streakLen = P[3];\n  M.p_streakCool = P[4];\n  M.p_sweeps = int(rint(P[5]));\n  M.p_beats = int(rint(P[6]));\n  M.p_hitAmt = P[7];\n  M.p_hit = P[8];\n  M.p_exposure = P[9];\n  M.p_vignette = P[10];\n  M.p_hud = P[11] > 0.5;\n  M.p_readout = P[12];\n  float2 fc = float2(pos.x, U.res.y - pos.y);     // GL convention: origin bottom-left\n  M.gl_FragCoord = float4(fc, pos.z, pos.w);\n  float4 c = M.motif(M.M_uv(fc), fc);\n  if (any(isnan(c))) c = float4(0.0);\n  if (U.encode < 0.5) return c;\n  c = max(c, float4(0.0));\n  float a = clamp(max(c.a, max(c.r, max(c.g, c.b))), 0.0, 1.0);\n  float3 s = a > 1e-5 ? M_clamp(c.rgb / a, 0.0, 1.0) : float3(0.0);\n  s = M.M_srgb(s) + M.M_dither(fc) / 255.0;\n  return float4(M_clamp(s, 0.0, 1.0) * a, a);\n}\n","wallcast_prism_split_p1":"// Generated by motif-metal from wallcast/prism-split, pass 2 of 2 (styles/prism-split.glsl). Do not edit.\n#include <metal_stdlib>\nusing namespace metal;\n\n// ---- host uniforms (mirrors MotifUniforms.swift; 144 bytes) --------------------------------------------------\nstruct MotifUniforms {\n  float2 res;      // pass resolution in pixels\n  float  p;        // loop phase 0..1\n  float  L;        // effective loop length in seconds\n  float  seed;     // 1..9999\n  float  safe;     // 1 = photosensitive-safe limiter\n  float  encode;   // 0 = linear premultiplied RGBA, 1 = web-identical final (sRGB, dithered, premultiplied)\n  float  _pad;\n  float4 bg;       // palette, linear RGB in xyz\n  float4 ink;\n  float4 a0;\n  float4 a1;\n  float4 a2;\n  float4 media0;   // media input 0: x = attached (0/1), y = video time, zw = pixel size\n  float4 media1;\n};\n\n// ---- textures: GL samples with v = 0 at the bottom; Metal stores row 0 on top, so v is flipped here ------------\nstruct MTex { texture2d<float> t; };\nconstexpr sampler M_smp(coord::normalized, address::clamp_to_edge, filter::linear, mip_filter::linear);\ninline float4 M_tex(MTex s, float2 uv) { return s.t.sample(M_smp, float2(uv.x, 1.0 - uv.y)); }\ninline float4 M_texLod(MTex s, float2 uv, float lod) { return s.t.sample(M_smp, float2(uv.x, 1.0 - uv.y), level(lod)); }\ninline float4 M_texelFetch(MTex s, int2 p, int lod) { return s.t.read(uint2(p.x, int(s.t.get_height(uint(lod))) - 1 - p.y), uint(lod)); }\ninline int2 M_texSize(MTex s, int lod) { return int2(int(s.t.get_width(uint(lod))), int(s.t.get_height(uint(lod)))); }\n\n// ---- GLSL maths that Metal lacks or spells differently --------------------------------------------------------\n// GLSL lets scalars stand in for vectors in min/max/clamp/mix/step/smoothstep/mod; Metal's overloads do not.\ntemplate <typename T> inline T M_min(T a, T b) { return metal::min(a, b); }\ntemplate <typename T> inline T M_max(T a, T b) { return metal::max(a, b); }\ntemplate <typename T> inline T M_clamp(T x, T lo, T hi) { return metal::clamp(x, lo, hi); }\ntemplate <typename T> inline T M_mix(T a, T b, T t) { return metal::mix(a, b, t); }\ntemplate <typename T> inline T M_mix(T a, T b, bool t) { return t ? b : a; }\ntemplate <typename T> inline T M_step(T e, T x) { return metal::step(e, x); }\ntemplate <typename T> inline T M_mod(T x, T y) { return x - y * metal::floor(x / y); }\ninline float2 M_min(float2 a, float b) { return metal::min(a, float2(b)); }\ninline float2 M_max(float2 a, float b) { return metal::max(a, float2(b)); }\ninline float2 M_clamp(float2 x, float lo, float hi) { return metal::clamp(x, float2(lo), float2(hi)); }\ninline float2 M_mix(float2 a, float2 b, float t) { return metal::mix(a, b, float2(t)); }\ninline float2 M_mix(float2 a, float2 b, bool2 t) { return select(a, b, t); }\ninline float2 M_step(float e, float2 x) { return metal::step(float2(e), x); }\ninline float2 M_mod(float2 x, float y) { return x - float2(y) * metal::floor(x / float2(y)); }\ninline float3 M_min(float3 a, float b) { return metal::min(a, float3(b)); }\ninline float3 M_max(float3 a, float b) { return metal::max(a, float3(b)); }\ninline float3 M_clamp(float3 x, float lo, float hi) { return metal::clamp(x, float3(lo), float3(hi)); }\ninline float3 M_mix(float3 a, float3 b, float t) { return metal::mix(a, b, float3(t)); }\ninline float3 M_mix(float3 a, float3 b, bool3 t) { return select(a, b, t); }\ninline float3 M_step(float e, float3 x) { return metal::step(float3(e), x); }\ninline float3 M_mod(float3 x, float y) { return x - float3(y) * metal::floor(x / float3(y)); }\ninline float4 M_min(float4 a, float b) { return metal::min(a, float4(b)); }\ninline float4 M_max(float4 a, float b) { return metal::max(a, float4(b)); }\ninline float4 M_clamp(float4 x, float lo, float hi) { return metal::clamp(x, float4(lo), float4(hi)); }\ninline float4 M_mix(float4 a, float4 b, float t) { return metal::mix(a, b, float4(t)); }\ninline float4 M_mix(float4 a, float4 b, bool4 t) { return select(a, b, t); }\ninline float4 M_step(float e, float4 x) { return metal::step(float4(e), x); }\ninline float4 M_mod(float4 x, float y) { return x - float4(y) * metal::floor(x / float4(y)); }\ninline int2 M_min(int2 a, int b) { return metal::min(a, int2(b)); }\ninline int2 M_max(int2 a, int b) { return metal::max(a, int2(b)); }\ninline int2 M_clamp(int2 x, int lo, int hi) { return metal::clamp(x, int2(lo), int2(hi)); }\ninline int3 M_min(int3 a, int b) { return metal::min(a, int3(b)); }\ninline int3 M_max(int3 a, int b) { return metal::max(a, int3(b)); }\ninline int3 M_clamp(int3 x, int lo, int hi) { return metal::clamp(x, int3(lo), int3(hi)); }\ninline int4 M_min(int4 a, int b) { return metal::min(a, int4(b)); }\ninline int4 M_max(int4 a, int b) { return metal::max(a, int4(b)); }\ninline int4 M_clamp(int4 x, int lo, int hi) { return metal::clamp(x, int4(lo), int4(hi)); }\ninline uint2 M_min(uint2 a, uint b) { return metal::min(a, uint2(b)); }\ninline uint2 M_max(uint2 a, uint b) { return metal::max(a, uint2(b)); }\ninline uint2 M_clamp(uint2 x, uint lo, uint hi) { return metal::clamp(x, uint2(lo), uint2(hi)); }\ninline uint3 M_min(uint3 a, uint b) { return metal::min(a, uint3(b)); }\ninline uint3 M_max(uint3 a, uint b) { return metal::max(a, uint3(b)); }\ninline uint3 M_clamp(uint3 x, uint lo, uint hi) { return metal::clamp(x, uint3(lo), uint3(hi)); }\ninline uint4 M_min(uint4 a, uint b) { return metal::min(a, uint4(b)); }\ninline uint4 M_max(uint4 a, uint b) { return metal::max(a, uint4(b)); }\ninline uint4 M_clamp(uint4 x, uint lo, uint hi) { return metal::clamp(x, uint4(lo), uint4(hi)); }\ntemplate <typename T> inline T M_smoothstep(T a, T b, T x) { T t = metal::clamp((x - a) / (b - a), T(0), T(1)); return t * t * (T(3) - T(2) * t); }\ninline float2 M_smoothstep(float a, float b, float2 x) { return M_smoothstep(float2(a), float2(b), x); }\ninline float3 M_smoothstep(float a, float b, float3 x) { return M_smoothstep(float3(a), float3(b), x); }\ninline float4 M_smoothstep(float a, float b, float4 x) { return M_smoothstep(float4(a), float4(b), x); }\n\ntemplate <typename T> inline T M_radians(T d) { return d * 0.017453292519943295; }\ntemplate <typename T> inline T M_degrees(T r) { return r * 57.29577951308232; }\ntemplate <typename A, typename B> inline auto M_lessThan(A a, B b) { return a < b; }\ntemplate <typename A, typename B> inline auto M_lessThanEqual(A a, B b) { return a <= b; }\ntemplate <typename A, typename B> inline auto M_greaterThan(A a, B b) { return a > b; }\ntemplate <typename A, typename B> inline auto M_greaterThanEqual(A a, B b) { return a >= b; }\ntemplate <typename A, typename B> inline auto M_equal(A a, B b) { return a == b; }\ntemplate <typename A, typename B> inline auto M_notEqual(A a, B b) { return a != b; }\n// GLSL's == and != on vectors give one bool; Metal's give a bool vector.\ninline bool M_all(bool x) { return x; }\ninline bool M_all(bool2 x) { return all(x); }\ninline bool M_all(bool3 x) { return all(x); }\ninline bool M_all(bool4 x) { return all(x); }\ninline bool M_any(bool x) { return x; }\ninline bool M_any(bool2 x) { return any(x); }\ninline bool M_any(bool3 x) { return any(x); }\ninline bool M_any(bool4 x) { return any(x); }\ntemplate <typename A, typename B> inline bool M_eq(A a, B b) { return M_all(a == b); }\ntemplate <typename A, typename B> inline bool M_ne(A a, B b) { return M_any(a != b); }\ninline float2x2 M_matrixCompMult(float2x2 a, float2x2 b) { return float2x2(a[0] * b[0], a[1] * b[1]); }\ninline float3x3 M_matrixCompMult(float3x3 a, float3x3 b) { return float3x3(a[0] * b[0], a[1] * b[1], a[2] * b[2]); }\ninline float4x4 M_matrixCompMult(float4x4 a, float4x4 b) { return float4x4(a[0] * b[0], a[1] * b[1], a[2] * b[2], a[3] * b[3]); }\ninline float2x2 M_inverse(float2x2 m) { float d = m[0][0] * m[1][1] - m[1][0] * m[0][1]; return float2x2(float2(m[1][1], -m[0][1]), float2(-m[1][0], m[0][0])) * (1.0 / d); }\ninline float3x3 M_inverse(float3x3 m) {\n  float3 a = m[0], b = m[1], c = m[2];\n  float3 r0 = cross(b, c), r1 = cross(c, a), r2 = cross(a, b);\n  float inv = 1.0 / dot(r2, c);\n  return float3x3(float3(r0.x, r1.x, r2.x), float3(r0.y, r1.y, r2.y), float3(r0.z, r1.z, r2.z)) * inv;\n}\n// GL's window y points up and the entry point flips Metal's (fc.y = height - pos.y), so dFdy changes sign.\ntemplate <typename T> inline T M_dFdy(T v) { return -dfdy(v); }\ninline uint   floatBitsToUint(float x)  { return as_type<uint>(x); }\ninline uint2  floatBitsToUint(float2 x) { return as_type<uint2>(x); }\ninline uint3  floatBitsToUint(float3 x) { return as_type<uint3>(x); }\ninline uint4  floatBitsToUint(float4 x) { return as_type<uint4>(x); }\ninline int    floatBitsToInt(float x)   { return as_type<int>(x); }\ninline int2   floatBitsToInt(float2 x)  { return as_type<int2>(x); }\ninline int3   floatBitsToInt(float3 x)  { return as_type<int3>(x); }\ninline int4   floatBitsToInt(float4 x)  { return as_type<int4>(x); }\ninline float  uintBitsToFloat(uint x)   { return as_type<float>(x); }\ninline float2 uintBitsToFloat(uint2 x)  { return as_type<float2>(x); }\ninline float3 uintBitsToFloat(uint3 x)  { return as_type<float3>(x); }\ninline float4 uintBitsToFloat(uint4 x)  { return as_type<float4>(x); }\ninline float  intBitsToFloat(int x)     { return as_type<float>(x); }\n\n// ---- hoisted: macros, structs, program-scope constants ---------------------------------------------------------\n#define TAU 6.283185307179586\n#define PI 3.141592653589793\n#define M_PH (u_p * TAU)\n\n// ---- pass: every function is a member so uniforms read as plain identifiers --------------------------------------\nstruct MPass_wallcast_prism_split_p1 {\nfloat2 u_res;\nfloat u_p;\nfloat u_L;\nfloat u_seed;\nfloat u_safe;\nfloat3 u_bg, u_ink, u_a0, u_a1, u_a2;\nMTex u_buf0, u_buf1, u_buf2, u_buf3;\nuint M_pcg(uint v) { uint s = v * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }\nuint M_seedU() { return M_pcg(uint(u_seed) * 2654435761u); }\nfloat M_u2f(uint x) { return float(x >> 8u) * (1.0 / 16777216.0); }\nfloat h11(float x) { return M_u2f(M_pcg(floatBitsToUint(x + 0.0) ^ M_seedU())); }\nfloat h21(float2 p) { return M_u2f(M_pcg(M_pcg(floatBitsToUint(p.x + 0.0) ^ M_seedU()) ^ floatBitsToUint(p.y + 0.0))); }\nfloat2 h22(float2 p) { uint a = M_pcg(M_pcg(floatBitsToUint(p.x + 0.0) ^ M_seedU()) ^ floatBitsToUint(p.y + 0.0)); return float2(M_u2f(a), M_u2f(M_pcg(a))); }\nfloat3 h33(float3 p) { uint a = M_pcg(M_pcg(M_pcg(floatBitsToUint(p.x + 0.0) ^ M_seedU()) ^ floatBitsToUint(p.y + 0.0)) ^ floatBitsToUint(p.z + 0.0)); uint b = M_pcg(a); return float3(M_u2f(a), M_u2f(b), M_u2f(M_pcg(b))); }\nfloat2 M_seedOff() { return float2(M_u2f(M_seedU()), M_u2f(M_pcg(M_seedU()))) * 173.0 - 86.0; }\nfloat2x2 rot(float a) { float c = cos(a), s = sin(a); return float2x2(float2(c, s),float2( -s, c)); }\nfloat sat(float x) { return M_clamp(x, 0.0, 1.0); }\nfloat3 sat(float3 x) { return M_clamp(x, 0.0, 1.0); }\nfloat remap(float x, float a, float b) { return sat((x - a) / (b - a)); }\nfloat smin(float a, float b, float k) { float h = sat(0.5 + 0.5 * (b - a) / k); return M_mix(b, a, h) - k * h * (1.0 - h); }\nfloat smax(float a, float b, float k) { return -smin(-a, -b, k); }\nfloat luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }\nfloat2 lc(float k, float ph) { float a = TAU * (k * u_p + ph); return float2(cos(a), sin(a)); }\nfloat lsin(float k, float ph) { return sin(TAU * (k * u_p + ph)); }\nfloat lsaw(float k, float ph) { return fract(k * u_p + ph); }\nfloat4 M_mod289(float4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }\nfloat3 M_mod289(float3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }\nfloat M_mod289(float x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }\nfloat4 M_perm(float4 x) { return M_mod289(((x * 34.0) + 1.0) * x); }\nfloat M_perm(float x) { return M_mod289(((x * 34.0) + 1.0) * x); }\nfloat4 M_tis(float4 r) { return 1.79284291400159 - 0.85373472095314 * r; }\nfloat M_tis(float r) { return 1.79284291400159 - 0.85373472095314 * r; }\nfloat snoise(float3 v) {\n  const float2 C = float2(1.0 / 6.0, 1.0 / 3.0); const float4 D = float4(0.0, 0.5, 1.0, 2.0);\n  float3 i = floor(v + dot(v, C.yyy)); float3 x0 = v - i + dot(i, C.xxx);\n  float3 g = M_step(x0.yzx, x0.xyz); float3 l = 1.0 - g; float3 i1 = M_min(g.xyz, l.zxy); float3 i2 = M_max(g.xyz, l.zxy);\n  float3 x1 = x0 - i1 + C.xxx; float3 x2 = x0 - i2 + C.yyy; float3 x3 = x0 - D.yyy;\n  i = M_mod289(i);\n  float4 p = M_perm(M_perm(M_perm(i.z + float4(0.0, i1.z, i2.z, 1.0)) + i.y + float4(0.0, i1.y, i2.y, 1.0)) + i.x + float4(0.0, i1.x, i2.x, 1.0));\n  float n_ = 0.142857142857; float3 ns = n_ * D.wyz - D.xzx;\n  float4 j = p - 49.0 * floor(p * ns.z * ns.z); float4 x_ = floor(j * ns.z); float4 y_ = floor(j - 7.0 * x_);\n  float4 x = x_ * ns.x + ns.yyyy; float4 y = y_ * ns.x + ns.yyyy; float4 h = 1.0 - abs(x) - abs(y);\n  float4 b0 = float4(x.xy, y.xy); float4 b1 = float4(x.zw, y.zw);\n  float4 s0 = floor(b0) * 2.0 + 1.0; float4 s1 = floor(b1) * 2.0 + 1.0; float4 sh = -M_step(h, float4(0.0));\n  float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy; float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;\n  float3 p0 = float3(a0.xy, h.x); float3 p1 = float3(a0.zw, h.y); float3 p2 = float3(a1.xy, h.z); float3 p3 = float3(a1.zw, h.w);\n  float4 norm = M_tis(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\n  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;\n  float4 m = M_max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0); m = m * m;\n  return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));\n}\nfloat4 M_grad4(float j, float4 ip) {\n  const float4 ones = float4(1.0, 1.0, 1.0, -1.0); float4 p, s;\n  p.xyz = floor(fract(float3(j) * ip.xyz) * 7.0) * ip.z - 1.0; p.w = 1.5 - dot(abs(p.xyz), ones.xyz);\n  s = float4(M_lessThan(p, float4(0.0))); p.xyz = p.xyz + (s.xyz * 2.0 - 1.0) * s.www; return p;\n}\nfloat snoise(float4 v) {\n  const float4 C = float4(0.138196601125011, 0.276393202250021, 0.414589803375032, -0.447213595499958);\n  float4 i = floor(v + dot(v, float4(0.309016994374947451))); float4 x0 = v - i + dot(i, C.xxxx);\n  float4 i0; float3 isX = M_step(x0.yzw, x0.xxx); float3 isYZ = M_step(x0.zww, x0.yyz);\n  i0.x = isX.x + isX.y + isX.z; i0.yzw = 1.0 - isX; i0.y += isYZ.x + isYZ.y; i0.zw += 1.0 - isYZ.xy; i0.z += isYZ.z; i0.w += 1.0 - isYZ.z;\n  float4 i3 = M_clamp(i0, 0.0, 1.0); float4 i2 = M_clamp(i0 - 1.0, 0.0, 1.0); float4 i1 = M_clamp(i0 - 2.0, 0.0, 1.0);\n  float4 x1 = x0 - i1 + C.xxxx; float4 x2 = x0 - i2 + C.yyyy; float4 x3 = x0 - i3 + C.zzzz; float4 x4 = x0 + C.wwww;\n  i = M_mod289(i);\n  float j0 = M_perm(M_perm(M_perm(M_perm(i.w) + i.z) + i.y) + i.x);\n  float4 j1 = M_perm(M_perm(M_perm(M_perm(i.w + float4(i1.w, i2.w, i3.w, 1.0)) + i.z + float4(i1.z, i2.z, i3.z, 1.0)) + i.y + float4(i1.y, i2.y, i3.y, 1.0)) + i.x + float4(i1.x, i2.x, i3.x, 1.0));\n  float4 ip = float4(1.0 / 294.0, 1.0 / 49.0, 1.0 / 7.0, 0.0);\n  float4 p0 = M_grad4(j0, ip); float4 p1 = M_grad4(j1.x, ip); float4 p2 = M_grad4(j1.y, ip); float4 p3 = M_grad4(j1.z, ip); float4 p4 = M_grad4(j1.w, ip);\n  float4 norm = M_tis(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));\n  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w; p4 *= M_tis(dot(p4, p4));\n  float3 m0 = M_max(0.6 - float3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0); float2 m1 = M_max(0.6 - float2(dot(x3, x3), dot(x4, x4)), 0.0);\n  m0 = m0 * m0; m1 = m1 * m1;\n  return 49.0 * (dot(m0 * m0, float3(dot(p0, x0), dot(p1, x1), dot(p2, x2))) + dot(m1 * m1, float2(dot(p3, x3), dot(p4, x4))));\n}\nfloat ln2(float2 x, float k, float r) { return snoise(float4(x + M_seedOff(), r * lc(k, 0.0))); }\nfloat ln3(float3 x, float k, float r) { float2 c = r * lc(k, 0.0); return snoise(float4(x.xy + M_seedOff(), x.z + c.x, c.y)); }\nfloat lfbm(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln2(x, k, r); x = m * x + 11.7; a *= 0.5; }\n  return s;\n}\nfloat lfbm3(float3 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5;\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln3(x, k, r); x = x * 2.02 + float3(7.1, 3.3, 1.9); a *= 0.5; }\n  return s;\n}\nfloat lridge(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; float n = 1.0 - abs(ln2(x, k, r)); s += a * n * n; x = m * x + 5.3; a *= 0.5; }\n  return s;\n}\nfloat3 lvoro(float2 x, float jit, float k, float amp) {\n  float2 n = floor(x), f = fract(x); float d1 = 8.0, d2 = 8.0, id = 0.0;\n  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {\n    float2 g = float2(float(i), float(j)); float2 h = h22(n + g);\n    float2 o = 0.5 + jit * (h - 0.5) + amp * lc(k, h.x) * 0.5 * (0.5 + h.y);\n    float d = length(g + o - f);\n    if (d < d1) { d2 = d1; d1 = d; id = h.x; } else if (d < d2) d2 = d;\n  }\n  return float3(d1, d2, id);\n}\nfloat sdSeg(float2 p, float2 a, float2 b) { float2 pa = p - a, ba = b - a; float h = sat(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h); }\nfloat sdBox(float2 p, float2 b) { float2 d = abs(p) - b; return length(M_max(d, 0.0)) + M_min(M_max(d.x, d.y), 0.0); }\nfloat sdBox3(float3 p, float3 b) { float3 q = abs(p) - b; return length(M_max(q, 0.0)) + M_min(M_max(q.x, M_max(q.y, q.z)), 0.0); }\nfloat sdTorus(float3 p, float2 t) { float2 q = float2(length(p.xz) - t.x, p.y); return length(q) - t.y; }\nfloat glowd(float d, float w) { return w / (abs(d) + w); }\nfloat glow2(float d, float w) { float x = d / w; return 1.0 / (1.0 + x * x); }\nfloat gauss1(float d, float w) { return exp(-d * d / (w * w)); }\nfloat line(float d, float w) { return 1.0 - M_smoothstep(w * 0.5, w * 0.5 + 1.5 / M_min(u_res.x, u_res.y), d); }\nfloat aa() { return 1.5 / M_min(u_res.x, u_res.y); }\nfloat3 ramp(float t) { \n  t = sat(t) * 4.0;\n  if (t < 1.0) return M_mix(u_bg, u_a2, t);\n  if (t < 2.0) return M_mix(u_a2, u_a0, t - 1.0);\n  if (t < 3.0) return M_mix(u_a0, u_a1, t - 2.0);\n  return M_mix(u_a1, u_ink, t - 3.0);\n}\nfloat3 accent(float i) { float j = M_mod(floor(i), 3.0); return j < 0.5 ? u_a0 : j < 1.5 ? u_a1 : u_a2; }\nfloat3 hot(float t) { t = M_max(t, 0.0); return M_mix(u_a2, u_a0, sat(t * 1.4)) * sat(t * 3.0) + u_ink * M_max(t - 0.6, 0.0) * 1.2 + u_a1 * sat(t - 1.0) * 0.5; }\nfloat3 aces(float3 x) { return sat((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)); }\nfloat3 bb(float T) { \n  T = M_clamp(T, 1000.0, 40000.0) / 100.0; float3 c;\n  c.r = T <= 66.0 ? 1.0 : sat(1.2929 * pow(T - 60.0, -0.1332));\n  c.g = T <= 66.0 ? sat(0.3901 * log(T) - 0.6318) : sat(1.1298 * pow(T - 60.0, -0.0755));\n  c.b = T >= 66.0 ? 1.0 : (T <= 19.0 ? 0.0 : sat(0.5432 * log(T - 10.0) - 1.1963));\n  return c * c;\n}\nfloat4 emit(float3 c) { c = M_max(c, 0.0); return float4(c, M_max(c.r, M_max(c.g, c.b))); }\nfloat4 solid(float3 c, float a) { return float4(c * a, a); }\nfloat4 over(float4 top, float4 base) { return top + base * (1.0 - top.a); }\nfloat4 addc(float4 a, float4 b) { return float4(a.rgb + b.rgb, M_max(a.a, b.a)); }\nfloat M_rate(float n) { n = M_max(0.0, floor(n + 0.5)); return u_safe > 0.5 ? M_min(n, floor(3.0 * u_L)) : n; }\nfloat tslot(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : floor(fract(u_p) * r); }\nfloat tfrac(float n) { float r = M_rate(n); return r < 1.0 ? 0.0 : fract(fract(u_p) * r); }\nfloat safeCycles(float k) { return M_rate(k); }\nfloat strobe(float k, float duty) { float r = M_rate(k); if (r < 1.0) return duty; float f = fract(u_p * r); float soft = u_safe > 0.5 ? 0.18 : 0.02; return M_smoothstep(0.0, soft, f) * (1.0 - M_smoothstep(duty, duty + soft, f)); }\nfloat flashAmt(float x) { return u_safe > 0.5 ? x * 0.35 : x; }\nfloat pulse(float s, float k, float ph, float wd) { float x = fract(s - k * u_p - ph); return exp(-x * x / (wd * wd)) + exp(-(1.0 - x) * (1.0 - x) / (wd * wd)); }\nfloat growEnv(float h) { float x = fract(u_p); float a = (1.0 - h) * 0.5; return M_smoothstep(0.0, a, x) * (1.0 - M_smoothstep(1.0 - a * 0.6, 1.0, x)); }\nfloat2 M_uv(float2 fc) { return (fc - 0.5 * u_res) / M_min(u_res.x, u_res.y); }\nfloat2 M_asp() { return u_res / M_min(u_res.x, u_res.y); }\nfloat4 buf(MTex b, float2 fc) { return M_tex(b, fc / u_res); }\nfloat p_split;\nbool p_spectral;\nfloat p_streak;\nfloat p_streakLen;\nfloat p_streakCool;\nint p_sweeps;\nint p_beats;\nfloat p_hitAmt;\nfloat p_hit;\nfloat p_exposure;\nfloat p_vignette;\nbool p_hud;\nfloat p_readout;\nMTex u_source;\nfloat u_sourceOn;\nfloat2 u_sourceSize;\nfloat u_sourceTime;\nfloat4 m_source(float2 q) { return M_tex(u_source, M_clamp(q, float2(0.0), float2(1.0))); }\nfloat4 m_sourcePx(float2 fc) { return m_source(fc / u_res); }\nfloat4 m_sourceUV(float2 uv) { return m_source(uv * M_min(u_res.x, u_res.y) / u_res + 0.5); }\nfloat3 W_src(float2 q) {\n  q=M_clamp(q,float2(0.0),float2(1.0));\n  if(u_sourceOn>0.5){float4 s=m_source(q);return s.rgb+u_bg*(1.0-s.a);}\n  return M_tex(u_buf0,q).rgb;\n}\nfloat W_beat() {\n  float r=safeCycles(float(p_beats));\n  if(r<1.0) return 0.0;\n  float f=fract(u_p*r);\n  return 1.25*M_smoothstep(0.0,0.04,f)*exp(-f*5.0);\n}\nfloat W_drive() {return M_clamp(W_beat()*p_hitAmt+p_hit,0.0,1.5);}\nfloat W_box(float2 p, float2 c, float2 h) {float2 d=abs(p-c)-h;return M_step(M_max(d.x,d.y),0.0);}\nfloat W_digit(float2 p, int d) {\n  const array<int,10> M=array<int,10>{63,6,91,79,102,109,125,7,127,111};\n  int m=M[M_clamp(d,0,9)];\n  float t=0.09,s=0.0;\n  if((m&1)!=0)  s+=W_box(p,float2(