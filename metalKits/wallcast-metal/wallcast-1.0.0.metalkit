v-t0)/float2(wd,ht);\n  if(g.x>=0.0&&g.x<=1.0&&g.y>=-0.3&&g.y<=1.4){\n    float env=1.25*M_smoothstep(0.0,0.04,g.x)*exp(-g.x*5.0);\n    float ln=1.0-M_smoothstep(th*0.8,th*1.7,abs(uv.y-(t0.y+env*ht*0.8)));\n    float r=safeCycles(float(p_beats));\n    float ph=r<1.0?0.0:fract(u_p*r);\n    float head=(1.0-M_smoothstep(th*0.6,th*1.5,abs(g.x-ph)*wd))*M_step(0.0,g.y)*M_step(g.y,1.0);\n    col+=u_a1*(ln*1.2+head*0.5);\n  }\n  return col;\n}\nfloat3 W_finish(float3 col, float2 uv) {\n  float2 h=M_asp()*0.5;\n  float v=dot(uv,uv)/dot(h,h);\n  return M_max(col*p_exposure*(1.0-p_vignette*0.6*v),float3(0.0));\n}\nfloat W_dot(float2 q, float ang, int ch, float cells, float gain, bool inv) {\n  float2 A=M_asp();\n  float2 p=rot(ang)*(q*A)*cells;\n  float2 id=floor(p)+0.5,f=p-id;\n  float2 qq=(rot(-ang)*(id/cells))/A;\n  float3 s=W_src(qq);\n  float v=ch==0?s.r:(ch==1?s.g:s.b);\n  v=inv?1.0-M_clamp(pow(v,0.4545),0.0,1.0):pow(M_clamp(v,0.0,1.0),0.5);\n  float r=(inv?sqrt(v):v)*gain;\n  float l=length(f),aa2=fwidth(l)*0.75+1e-4;\n  return M_smoothstep(r+aa2,r-aa2,l);\n}\nfloat4 motif(float2 uv, float2 fc) {\n  float2 q=fc/u_res;\n  float k=W_drive();\n  float dr=p_drift*lsin(1.0,0.0);\n  float cells=float(p_cells);\n  float gain=p_gain*(1.0+0.28*M_min(k,1.2));\n  float reg=p_registration*0.004;\n  bool print=p_inkMode==1;\n  float3 cov=float3(W_dot(q+float2(reg,0.0),0.26+dr,0,cells,gain,print),\n                W_dot(q,0.79-dr,1,cells,gain,print),\n                W_dot(q-float2(reg,0.0),1.31+dr*1.5,2,cells,gain,print));\n  float3 col;\n  if(print){\n    float3 paper=u_ink*0.9;\n    col=paper*M_mix(float3(1.0),float3(0.02,0.95,1.0),cov.r)*M_mix(float3(1.0),float3(1.0,0.03,0.9),cov.g)*M_mix(float3(1.0),float3(1.0,0.95,0.03),cov.b);\n  }else{\n    col=cov*0.95+W_src(q)*p_under+u_bg;\n  }\n  col=W_finish(col,uv)+W_hud(uv);\n  return float4(col,1.0);\n}\nfloat4 gl_FragCoord;\nfloat M_dither(float2 fc) { return M_u2f(M_pcg(uint(fc.x) * 1973u ^ M_pcg(uint(fc.y) * 9277u))) - 0.5; }\nfloa