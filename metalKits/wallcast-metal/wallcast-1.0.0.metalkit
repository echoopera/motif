norm.y; p2 *= norm.z; p3 *= norm.w; p4 *= M_tis(dot(p4, p4));\n  float3 m0 = M_max(0.6 - float3(dot(x0, x0), dot(x1, x1), dot(x2, x2)), 0.0); float2 m1 = M_max(0.6 - float2(dot(x3, x3), dot(x4, x4)), 0.0);\n  m0 = m0 * m0; m1 = m1 * m1;\n  return 49.0 * (dot(m0 * m0, float3(dot(p0, x0), dot(p1, x1), dot(p2, x2))) + dot(m1 * m1, float2(dot(p3, x3), dot(p4, x4))));\n}\nfloat ln2(float2 x, float k, float r) { return snoise(float4(x + M_seedOff(), r * lc(k, 0.0))); }\nfloat ln3(float3 x, float k, float r) { float2 c = r * lc(k, 0.0); return snoise(float4(x.xy + M_seedOff(), x.z + c.x, c.y)); }\nfloat lfbm(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln2(x, k, r); x = m * x + 11.7; a *= 0.5; }\n  return s;\n}\nfloat lfbm3(float3 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5;\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; s += a * ln3(x, k, r); x = x * 2.02 + float3(7.1, 3.3, 1.9); a *= 0.5; }\n  return s;\n}\nfloat lridge(float2 x, int oct, float k, float r) {\n  float s = 0.0, a = 0.5; float2x2 m = float2x2(float2(1.6, 1.2),float2( -1.2, 1.6));\n  for (int i = 0; i < 8; i++) { if (i >= oct) break; float n = 1.0 - abs(ln2(x, k, r)); s += a * n * n; x = m * x + 5.3; a *= 0.5; }\n  return s;\n}\nfloat3 lvoro(float2 x, float jit, float k, float amp) {\n  float2 n = floor(x), f = fract(x); float d1 = 8.0, d2 = 8.0, id = 0.0;\n  for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {\n    float2 g = float2(float(i), float(j)); float2 h = h22(n + g);\n    float2 o = 0.5 + jit * (h - 0.5) + amp * lc(k, h.x) * 0.5 * (0.5 + h.y);\n    float d = length(g + o - f);\n    if (d < d1) { d2 = d1; d1 = d; id = h.x; } else if (d < d2) d2 = d;\n  }\n  return float3(d1, d2, id);\n}\nfloat sdSeg(float2 p, float2 a, float2 b) { float2 pa = p - a, ba = b - a; float h = sat(dot(pa, ba) / dot(ba, ba)); return length(pa - ba * h)