5*M_smoothstep(0.0,0.04,g.x)*exp(-g.x*5.0);\n    float ln=1.0-M_smoothstep(th*0.8,th*1.7,abs(uv.y-(t0.y+env*ht*0.8)));\n    float r=safeCycles(float(p_beats));\n    float ph=r<1.0?0.0:fract(u_p*r);\n    float head=(1.0-M_smoothstep(th*0.6,th*1.5,abs(g.x-ph)*wd))*M_step(0.0,g.y)*M_step(g.y,1.0);\n    col+=u_a1*(ln*1.2+head*0.5);\n  }\n  return col;\n}\nfloat3 W_finish(float3 col, float2 uv) {\n  float2 h=M_asp()*0.5;\n  float v=dot(uv,uv)/dot(h,h);\n  return M_max(col*p_exposure*(1.0-p_vignette*0.6*v),float3(0.0));\n}\nfloat W_l(float2 q) {return luma(W_src(q));}\nfloat W_sob(float2 q, float px) {\n  float2 d=px/u_res;\n  float tl=W_l(q+float2(-d.x,d.y)),t=W_l(q+float2(0.0,d.y)),tr=W_l(q+d),l=W_l(q+float2(-d.x,0.0)),r=W_l(q+float2(d.x,0.0)),bl=W_l(q-d),b=W_l(q-float2(0.0,d.y)),br=W_l(q+float2(d.x,-d.y));\n  float gx=-tl-2.0*l-bl+tr+2.0*r+br,gy=-tl-2.0*t-tr+bl+2.0*b+br;\n  return length(float2(gx,gy));\n}\nfloat4 motif(float2 uv, float2 fc) {\n  float2 q=fc/u_res;\n  float k=M_min(W_drive(),1.2);\n  float e=W_sob(q,p_width),e2=W_sob(q,4.0*p_spread),e3=W_sob(q,10.0*p_spread);\n  float line2=M_smoothstep(0.03,0.45,pow(e,0.7)*1.4);\n  float glow=e2*0.6+e3*0.35;\n  float l=pow(W_l(q),0.5);\n  float ph=q.x*p_hueSpan+q.y*p_hueSpan*0.5+l*0.5*p_hueSpan+safeCycles(float(p_hueCycles))*u_p;\n  float3 pal;\n  if(p_colorMode==0){\n    pal=0.5+0.5*cos(TAU*(float3(0.0,0.33,0.67)+ph));\n    pal*=pal;\n  }else if(p_colorMode==1){\n    float3 w=0.5+0.5*cos(TAU*(float3(ph)-float3(0.0,0.3333,0.6667)));\n    pal=(u_a0*w.x+u_a1*w.y+u_a2*w.z)/(w.x+w.y+w.z+1e-4)*1.3;\n  }else{\n    pal=u_ink;\n  }\n  float band=1.0;\n  if(safeCycles(float(p_gate))>=1.0){\n    float c=lsaw(safeCycles(float(p_gate)),0.0)*1.4-0.2;\n    band=1.0+1.6*exp(-pow((q.x-c)*5.0,2.0));\n  }\n  float3 col=W_src(q)*p_base+pal*(line2*1.3+glow*p_glow*(0.6+1.2*k))*band;\n  col=W_finish(col,uv)+W_hud(uv);\n  return float4(col,1.0);\n}\nfloat4 gl_FragCoord;\nfloat M_dither(float2 fc) { return M_u2f(M_pcg(uint(fc.x) * 1973u ^ M_