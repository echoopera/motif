{"format":"motif-metal@1","kit":{"format":"motif-metal@1","source":"motif-kit@1","sdk":"1.2.0","id":"wallcast","name":"Wallcast","version":"1.0.0","author":"Echo Opera","description":"Ten image shaders for on-air graphics, cyber-city screens and EDM video walls. Attach a still or clip to a layer and treat it; a night-skyline test image plays when nothing is attached.","accent":"#FF9A2E","license":"All rights reserved","palettes":[{"id":"amber","name":"Amber Signal","bg":"#0A0B0D","ink":"#EBE8E1","a":["#FF9A2E","#5FE3D0","#FF4133"]},{"id":"ice","name":"Ice Broadcast","bg":"#060A12","ink":"#EAF4FF","a":["#4CC9F0","#F72585","#FFD166"]},{"id":"magenta","name":"Festival Magenta","bg":"#0B0710","ink":"#F6ECFF","a":["#FF2E93","#39F0C8","#FFB800"]},{"id":"steel","name":"Steel Mono","bg":"#08090A","ink":"#F2F2EE","a":["#C9CCCF","#7C8790","#E8E4D8"]}],"styles":[{"id":"wallcast/prism-split","localId":"prism-split","name":"Prism Split","blurb":"Radial colour split and anamorphic light streaks that flare on every kick.","group":"Optics","tags":["chromatic","streak","lens","on-air"],"palette":"amber","flash":true,"cost":1,"passes":[{"function":"mfs_wallcast_prism_split_p0","source":"wallcast_prism_split_p0","scale":0.5},{"function":"mfs_wallcast_prism_split_p1","source":"wallcast_prism_split_p1","scale":1}],"inputs":[{"id":"source","type":"media","label":"Source","fit":"fill","hint":"Still or clip to treat. Without one, the kit's test image plays."}],"params":[{"key":"split","index":0,"type":"range","label":"Split","def":0.022,"min":0,"max":0.08,"step":0.001,"mutate":0.7},{"key":"spectral","index":1,"type":"toggle","label":"Spectral fringe","def":true,"hint":"Adds a seven-tap rainbow fringe on top of the RGB split.","mutate":0.2},{"key":"streak","index":2,"type":"range","label":"Streak gain","def":0.9,"min":0,"max":2,"step":0.01,"unit":"×","group":"Streaks","mutate":0.6},{"key":"streakLen","index":3,"type":"range","label":"Streak length","def":0.22,"min":0.05,"max":0.5,"step":0.0