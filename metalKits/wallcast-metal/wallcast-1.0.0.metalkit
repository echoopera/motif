:"wallcast_kaleido_wall_p0","scale":0.5},{"function":"mfs_wallcast_kaleido_wall_p1","source":"wallcast_kaleido_wall_p1","scale":1}],"inputs":[{"id":"source","type":"media","label":"Source","fit":"fill","hint":"Still or clip to treat. Without one, the kit's test image plays."}],"params":[{"key":"segments","index":0,"type":"int","label":"Segments","def":6,"min":3,"max":12,"step":1,"mutate":0.4},{"key":"spin","index":1,"type":"int","label":"Spin / loop","def":1,"min":-2,"max":2,"step":1,"mutate":0.3},{"key":"scale","index":2,"type":"range","label":"Pattern scale","def":0.9,"min":0.3,"max":1.5,"step":0.01,"mutate":0.5},{"key":"breathe","index":3,"type":"range","label":"Breathe","def":0.08,"min":0,"max":0.3,"step":0.01,"mutate":0.4},{"key":"drift","index":4,"type":"int","label":"Drift / loop","def":0,"min":0,"max":2,"step":1,"hint":"Whole mirror periods per loop.","mutate":0.2},{"key":"chroma","index":5,"type":"range","label":"Colour split","def":0.5,"min":0,"max":1,"step":0.01,"mutate":0.5},{"key":"centerX","index":6,"type":"range","label":"Centre X","def":0,"min":-0.5,"max":0.5,"step":0.0025,"hint":"Moves the point the pattern folds around.","part":{"of":"center","kind":"point","i":0,"label":"Centre"}},{"key":"centerY","index":7,"type":"range","label":"Centre Y","def":0,"min":-0.5,"max":0.5,"step":0.0025,"hint":"Moves the point the pattern folds around.","part":{"of":"center","kind":"point","i":1,"label":"Centre"}},{"key":"seams","index":8,"type":"range","label":"Seams","def":0.35,"min":0,"max":1,"step":0.01,"mutate":0.4},{"key":"beats","index":9,"type":"int","label":"Beats / loop","def":4,"min":1,"max":16,"step":1,"group":"Beat","hint":"Kick pulses per loop. The limiter caps this at 3 per second.","mutate":0.3},{"key":"hitAmt","index":10,"type":"range","label":"Beat drive","def":1,"min":0,"max":1.5,"step":0.01,"unit":"×","group":"Beat","hint":"How hard the internal beat drives the effect.","mutate":0.5},{"key":"hit","index":11,"type":"range","label":"Hit","def":0,"min":0,"max":1,"step":0.01,"group":"Beat","hint":"Map a live kick band here to drive the effect from audio.","mutate":0},{"key":"exposure","index":12,"type":"range","label":"Exposure","def":1,"min":0.4,"max":1.6,"step":0.01,"unit":"×","group":"Finish","mutate":0.2},{"key":"vignette","index":13,"type":"range","label":"Vignette","def":0.4,"min":0,"max":1,"step":0.01,"group":"Finish","mutate":0.3},{"key":"hud","index":14,"type":"toggle","label":"HUD frame","def":false,"group":"HUD","hint":"Corner brackets, numeric readout and a beat trace.","mutate":0},{"key":"readout","index":15,"type":"range","label":"Readout","def":128,"min":0,"max":9999,"step":1,"group":"HUD","hint":"Shown as four digits. Key it or map a data channel to it.","mutate":0,"show":{"param":"hud","is":true}}]}]},"sources":{"wallcast_prism_split_p0":"// Generated by motif-metal from wallcast/prism-split, pass 1 of 2 (styles/source.glsl). Do not edit.\n#include <metal_stdlib>\nusing namespace metal;\n\n// ---- host uniforms (mirrors MotifUniforms.swift; 144 bytes) --------------------------------------------------\nstruct MotifUniforms {\n  float2 res;      // pass resolution in pixels\n  float  p;        // loop phase 0..1\n  float  L;        // effective loop length in seconds\n  float  seed;     // 1..9999\n  float  safe;     // 1 = photosensitive-safe limiter\n  float  encode;   // 0 = linear premultiplied RGBA, 1 = web-identical final (sRGB, dithered, premultiplied)\n  float  _pad;\n  float4 bg;       // palette, linear RGB in xyz\n  float4 ink;\n  float4 a0;\n  float4 a1;\n  float4 a2;\n  float4 media0;   // media input 0: x = attached (0/1), y = video time, zw = pixel size\n  float4 media1;\n};\n\n// ---- textures: GL samples with v = 0 at the bottom; Metal stores row 0 on top, so v is flipped here ------------\nstruct MTex { texture2d<float> t; };\nconstexpr sampler M_smp(coord::normalized, address::clamp_to_edge, filter::linear, mip_filter::linear);\ninline float4 M_tex(MTex s, float2 uv) { return s.t.sample(M_smp, float2(uv.x, 1.0 - uv.y)); }\ninline float4 M_texLod(MTex s, float2 uv, float lod) { return s.t.sample(M_smp, float2(uv.x, 1.0 - uv.y), level(lod)); }\ninline float4 M_texelFetch(MTex s, int2 p, int lod) { return s.t.read(uint2(p.x, int(s.t.get_height(uint(lod))) - 1 - p.y), uint(lod)); }\ninline int2 M_texSize(MTex s, int lod) { return int2(int(s.t.get_width(uint(lod))), int(s.t.get_height(uint(lod)))); }\n\n// ---- GLSL maths that Metal lacks or spells differently --------------------------------------------------------\n// GLSL lets scalars stand in for vectors in min/max/clamp/mix/step/smoothstep/mod; Metal's overloads do not.\ntemplate <typename T> inline T M_min(T a, T b) { return metal::min(a, b); }\ntemplate <typename T> inline T M_max(T a, T b) { return metal::max(a, b); }\ntemplate <typename T> inline T M_clamp(T x, T lo, T hi) { return metal::clamp(x, lo, hi); }\ntemplate <typename T> inline T M_mix(T a, T b, T t) { return metal::mix(a, b, t); }\ntemplate <typename T> inline T M_mix(T a, T b, bool t) { return t ? b : a; }\ntemplate <typename T> inline T M_step(T e, T x) { return metal::step(e, x); }\ntemplate <typename T> inline T M_mod(T x, T y) { return x - y * metal::floor(x / y); }\ninline float2 M_min(float2 a, float b) { return metal::min(a, float2(b)); }\ninline float2 M_max(float2 a, float b) { return metal::max(a, float2(b)); }\ninline float2 M_clamp(float2 x, float lo, float hi) { return metal::clamp(x, float2(lo), float2(hi)); }\ninline float2 M_mix(float2 a, float2 b, float t) { return metal::mix(a, b, float2(t)); }\ninline float2 M_mix(float2 a, float2 b, bool2 t) { return select(a, b, t); }\ninline float2 M_step(float e, float2 x) { return metal::step(float2(e), x); }\ninline float2 M_mod(float2 x, float y) { return x - float2(y) * metal::floor(x / float2(y)); }\ninline float3 M_min(float3 a, float b) { return metal::min(a, float3(b)); }\ninline float3 M_max(float3 a, float b) { return metal::max(a, float3(b)); }\ninline float3 M_clamp(float3 x, float lo, float hi) { return metal::clamp(x, float3(lo), float3(hi)); }\ninline float3 M_mix(float3 a, float3 b, float t) { return metal::mix(a, b, float3(t)); }\ninline float3 M_mix(float3 a, float3 b, bool3 t) { return select(a, b, t); }\ninline float3 M_step(float e, float3 x) { return metal::step(float3(e), x); }\ninline float3 M_mod(float3 x, float y) { return x - float3(y) * metal::floor(x / float3(y)); }\ninline float4 M_min(float4 a, float b) { return metal::min(a, float4(b)); }\ninline float4 M_max(float4 a, float b) { return metal::max(a, float4(b)); }\ninline float4 M_clamp(float4 x, float lo, float hi) { return metal::clamp(x, float4(lo), float4(hi)); }\ninline float4 M_mix(float4 a, float4 b, float t) { return metal::mix(a, b, float4(t)); }\ninline float4 M_mix(float4 a, float4 b, bool4 t) { return select(a, b, t); }\ninline float4 M_step(float e, float4 x) { return metal::step(float4(e), x); }\ninline float4 M_mod(float4 x, float y) { return x - float4(y) * metal::floor(x / float4(y)); }\ninline int2 M_min(int2 a, int b) { return metal::min(a, int2(b)); }\ninline int2 M_max(int2 a, int b) { return metal::max(a, int2(b)); }\ninline int2 M_clamp(int2 x, int lo, int hi) { return metal::clamp(x, int2(lo), int2(hi)); }\ninline int3 M_min(int3 a, int b) { return metal::min(a, int3(b)); }\ninline int3 M_max(int3 a, int b) { return metal::max(a, int3(b)); }\ninline int3 M_clamp(int3 x, int lo, int hi) { return metal::clamp(x, int3(lo), int3(hi)); }\ninline int4 M_min(int4 a, int b) { return metal::min(a, int4(b)); }\ninline int4 M_max(int4 a, int b) { return metal::max(a, int4(b)); }\ninline int4 M_clamp(int4 x, int lo, int hi) { return metal::clamp(x, int4(lo), int4(hi)); }\ninline uint2 M_min(uint2 a, uint b) { return metal::min(a, uint2(b)); }\ninline uint2 M_max(uint2 a, uint b) { return metal::max(a, uint2(b)); }\ninline uint2 M_clamp(uint2 x, uint lo, uint hi) { return metal::clamp(x, uint2(lo), uint2(hi)); }\ninline uint3 M_min(uint3 a, uint b) { return metal::min(a, uint3(b)); }\ninline uint3 M_max(uint3 a, uint b) { return metal::max(a, uint3(b)); }\ninline uint3 M_clamp(uint3 x, uint lo, uint hi) { return metal::clamp(x, uint3(lo), uint3(hi)); }\ninline uint4 M_min(uint4 a, uint b) { return metal::min(a, uint4(b)); }\ninline uint4 M_max(uint4 a, uint b) { return metal::max(a, uint4(b)); }\ninline uint4 M_clamp(uint4 x, uint lo, uint hi) { return metal::clamp(x, uint4(lo), uint4(hi)); }\ntemplate <typename T> inline T M_smoothstep(T a, T b, T x) { T t = metal::clamp((x - a) / (b - a), T(0), T(1)); return t * t * (T(3) - T(2) * t); }\ninline float2 M_smoothstep(float a, float b, float2 x) { return M_smoothstep(float2(a), float2(b), x); }\ninline float3 M_smoothstep(float a, float b, float3 x) { return M_smoothstep(float3(a), float3(b), x); }\ninline float4 M_smoothstep(float a, float b, float4 x) { return M_smoothstep(float4(a), float4(b), x); }\n\ntemplate <typename T> inline T M_radians(T d) { return d * 0.017453292519943295; }\ntemplate <typename T> inline T M_degrees(T r) { return r * 57.29577951308232; }\ntemplate <typename A, typename B> inline auto M_lessThan(A a, B b) { return a < b; }\ntemplate <typename A, typename B> inline auto M_lessThanEqual(A a, B b) { return a <= b; }\ntemplate <typename A, typename B> inline auto M_greaterThan(A a, B b) { return a > b; }\ntemplate <typename A, typename B> inline auto M_greaterThanEqual(A a, B b) { return a >= b; }\ntemplate <typename A, typename B> inline auto M_equal(A a, B b) { return a == b; }\ntemplate <typename A, typename B> inline auto M_notEqual(A a, B b) { return a != b; }\n// GLSL's == and != on vectors give one bool; Metal's give a bool vector.\ninline bool M_all(bool x) { return x; }\ninline bool M_all(bool2 x) { return all(x); }\ninline bool M_all(bool3 x) { return all(x); }\ninline bool M_all(bool4 x) { return all(x); }\ninline bool M_any(bool x) { return x; }\ninline bool M_any(bool2 x) { return any(x); }\ninline bool M_any(bool3 x) { return any(x); }\ninline bool M_any(bool4 x) { return any(x); }\ntemplate <typename A, typename B> inline bool M_eq(A a, B b) { return M_all(a == b); }\ntemplate <typename A, typename B> inline bool M_ne(A a, B b) { return M_any(a != b); }\ninline float2x2 M_matrixCompMult(float2x2 a, float2x2 b) { return float2x2(a[0] * b[0], a[1] * b[1]); }\ninline float3x3 M_matrixCompMult(float3x3 a, float3x3 b) { return float3x3(a[0] * b[0], a[1] * b[1], a[2] * b[2]); }\ninline float4x4 M_matrixCompMult(float4x4 a, float4x4 b) { return float4x4(a[0] * b[0], a[1] * b[1], a[2] * b[2], a[3] * b[3]); }\ninline float2x2 M_inverse(float2x2 m) { float d = m[0][0] * m[1][1] - m[1][0] * m[0][1]; return float2x2(float2(m[1][1], -m[0][1]), float2(-m[1][0], m[0][0])) * (1.0 / d); }\ninline float3x3 M_inverse(float3x3 m) {\n  float3 a = m[0], b = m[1], c = m[2];\n  float3 r0 = cross(b, c), r1 = cross(c, a), r2 = cross(a, b);\n  float inv = 1.0 / dot(r2, c);\n  return float3x3(float3(r0.x, r1.x, r2.x), float3(r0.y, r1.y, r2.y), float3(r0.z, r1.z, r2.z)) * inv;\n}\n// GL's window y points up and the entry point flips Metal's (fc.y = height - pos.y), so dFdy changes sign.\ntemplate <typename T> inline T M_dFdy(T v) { return -dfdy(v); }\ninline uint   floatBitsToUint(float x)  { return as_type<uint>(x); }\ninline uint2  floatBitsToUint(float2 x) { return as_type<uint2>(x); }\ninline uint3  floatBitsToUint(float3 x) { return as_type<uint3>(x); }\ninline uint4  floatBitsToUint(float4 x) { return as_type<uint4>(x); }\ninline int    floatBitsToInt(float x)   { return as_type<int>(x); }\ninline int2   floatBitsToInt(float2 x)  { return as_type<int2>(x); }\ninline int3   floatBitsToInt(float3 x)  { return as_type<int3>(x); }\ninline int4   floatBitsToInt(float4 x)  { return as_type<int4>(x); }\ninline float  uintBitsToFloat(uint x)   { return as_type<float>(x); }\ninline float2 uintBitsToFloat(uint2 x)  { return as_type<float2>(x); }\ninline float3 uintBitsToFloat(uint3 x)  { return as_type<float3>(x); }\ninline float4 uintBitsToFloat(uint4 x)  { return as_type<float4>(x); }\ninline float  intBitsToFloat(int x)     { return as_type<float>(x); }\n\n// ---- hoisted: macros, structs, program-scope constants ---------------------------------------------------------\n#define TAU 6.283185307179586\n#define PI 3.141592653589793\n#define M_PH (u_p * TAU)\n\n// ---- pass: every function is a member so uniforms read as plain identifiers --------------------------------------\nstruct MPass_wallcast_prism_split_p0 {\nfloat2 u_res;\nfloat u_p;\nfloat u_L;\nfloat u_seed;\nfloat u_safe;\nfloat3 u_bg, u_ink, u_a0, u_a1, u_a2;\nMTex u_buf0, u_buf1, u_buf2, u_buf3;\nuint M_pcg(uint v) { uint s = v * 747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }\nuint M_seedU() { return M_pcg(uint(u_seed) * 2654435761u); }\nfloat M_u2f(uint x) { return float(x >> 8u) * (1.0 / 16777216.0); }\nfloat h11(float x) { return M_u2f(M_pcg(floatBitsToUint(x + 0.0) ^ M_seedU())); }\nfloat h21(float2 p) { return M_u2f(M_pcg(M_pcg(floatBitsToUint(p.x + 0.0) ^ M_seedU()) ^ floatBitsToUint(p.y + 0.0))); }\nfloat2 h22(float2 p) { uint a = M_pcg(M_pcg(floatBitsToUint(p.x + 0.0) ^ M_seedU()) ^ floatBitsToUint(p.y + 0.0)); return float2(M_u2f(a), M_u2f(M_pcg(a))); }\nfloat3 h33(float3 p) { uint a = M_pcg(M_pcg(M_pcg(floatBitsToUint(p.x + 0.0) ^ M_seedU()) ^ floatBitsToUint(p.y + 0.0)) ^ floatBitsToUint(p.z + 0.0)); uint b = M_pcg(a); return float3(M_u2f(a), M_u2f(b), M_u2f(M_pcg(b))); }\nfloat2 M_seedOff() { return float2(M_u2f(M_seedU()), M_u2f(M_pcg(M_seedU()))) * 173.0 - 86.0; }\nfloat2x2 rot(float a) { float c = cos(a), s = sin(a); return float2x2(float2(c, s),float2( -s, c)); }\nfloat sat(float x) { return M_clamp(x, 0.0, 1.0); }\nfloat3 sat(float3 x) { return M_clamp(x, 0.0, 1.0); }\nfloat remap(float x, float a, float b) { return sat((x - a) / (b - a)); }\nfloat smin(float a, float b, float k) { float h = sat(0.5 + 0.5 * (b - a) / k); return