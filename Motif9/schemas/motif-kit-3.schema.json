{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://motif.local/schemas/motif-kit-3.schema.json",
 "title": "Motif kit manifest (motif-kit@3, reads motif-kit@1 and motif-kit@2)",
 "description": "manifest.json of a .motifkit package. motif-kit@3 adds text inputs and the \"text\" capability to motif-kit@2, which is a superset of motif-kit@1: every valid @1 manifest is accepted (format \"motif-kit@1\") and migrated on load. The schema covers structure; the app additionally checks files exist, GLSL (static analysis + compile + canary) and graph ordering. Source of truth for behaviour: src-v5/modules/04-kit-gl.js and 04a-kit-sandbox.js. Text inputs (motif-kit@3 only): inputs[].type \"text\" declares 1–3 lines the host rasterizes into ONE atlas texture; strings never become GLSL uniforms (see sdk/motif-kit-sdk/docs/text-inputs.md).",
 "type": "object",
 "required": [
  "format",
  "id",
  "name",
  "version"
 ],
 "properties": {
  "format": {
   "enum": [
    "motif-kit@1",
    "motif-kit@2",
    "motif-kit@3"
   ]
  },
  "id": {
   "$ref": "#/$defs/id",
   "not": {
    "enum": [
     "core",
     "motif",
     "builtin",
     "all"
    ]
   }
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 32
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "author": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "license": {
   "type": "string"
  },
  "accent": {
   "$ref": "#/$defs/hex"
  },
  "common": {
   "$ref": "#/$defs/file"
  },
  "capabilities": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "enum": [
     "media",
     "audio",
     "feedback",
     "text"
    ]
   },
   "description": "motif-kit@2 and @3. Declared access the user approves at install (\"text\": @3 only, local font rasterization of text typed into the layer). Kits can never request network, DOM or script access."
  },
  "inputs": {
   "$ref": "#/$defs/inputs"
  },
  "palettes": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "$ref": "#/$defs/palette"
   }
  },
  "styles": {
   "type": "array",
   "maxItems": 40,
   "items": {
    "$ref": "#/$defs/style"
   }
  },
  "effects": {
   "type": "array",
   "maxItems": 24,
   "items": {
    "$ref": "#/$defs/effect"
   }
  },
  "transitions": {
   "type": "array",
   "maxItems": 24,
   "items": {
    "$ref": "#/$defs/transition"
   }
  },
  "exporters": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "$ref": "#/$defs/exporter"
   }
  }
 },
 "propertyNames": {
  "not": {
   "enum": [
    "__proto__",
    "constructor",
    "prototype"
   ]
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "format": {
      "const": "motif-kit@1"
     }
    }
   },
   "then": {
    "required": [
     "styles"
    ],
    "properties": {
     "styles": {
      "minItems": 1,
      "items": {
       "required": [
        "passes"
       ],
       "not": {
        "required": [
         "graph"
        ]
       }
      }
     }
    },
    "not": {
     "anyOf": [
      {
       "required": [
        "capabilities"
       ]
      },
      {
       "required": [
        "effects"
       ]
      },
      {
       "required": [
        "transitions"
       ]
      },
      {
       "required": [
        "exporters"
       ]
      }
     ]
    }
   }
  },
  {
   "if": {
    "properties": {
     "format": {
      "const": "motif-kit@2"
     }
    }
   },
   "then": {
    "anyOf": [
     {
      "required": [
       "styles"
      ],
      "properties": {
       "styles": {
        "minItems": 1
       }
      }
     },
     {
      "required": [
       "effects"
      ],
      "properties": {
       "effects": {
        "minItems": 1
       }
      }
     },
     {
      "required": [
       "transitions"
      ],
      "properties": {
       "transitions": {
        "minItems": 1
       }
      }
     },
     {
      "required": [
       "exporters"
      ],
      "properties": {
       "exporters": {
        "minItems": 1
       }
      }
     }
    ]
   }
  },
  {
   "if": {
    "not": {
     "properties": {
      "format": {
       "const": "motif-kit@3"
      }
     }
    }
   },
   "then": {
    "not": {
     "anyOf": [
      {
       "required": [
        "capabilities"
       ],
       "properties": {
        "capabilities": {
         "type": "array",
         "contains": {
          "const": "text"
         }
        }
       }
      },
      {
       "required": [
        "inputs"
       ],
       "properties": {
        "inputs": {
         "type": "array",
         "contains": {
          "required": [
           "type"
          ],
          "properties": {
           "type": {
            "const": "text"
           }
          }
         }
        }
       }
      },
      {
       "required": [
        "styles"
       ],
       "properties": {
        "styles": {
         "type": "array",
         "contains": {
          "required": [
           "inputs"
          ],
          "properties": {
           "inputs": {
            "type": "array",
            "contains": {
             "required": [
              "type"
             ],
             "properties": {
              "type": {
               "const": "text"
              }
             }
            }
           }
          }
         }
        }
       }
      }
     ]
    }
   }
  },
  {
   "if": {
    "properties": {
     "format": {
      "const": "motif-kit@3"
     }
    }
   },
   "then": {
    "anyOf": [
     {
      "required": [
       "styles"
      ],
      "properties": {
       "styles": {
        "minItems": 1
       }
      }
     },
     {
      "required": [
       "effects"
      ],
      "properties": {
       "effects": {
        "minItems": 1
       }
      }
     },
     {
      "required": [
       "transitions"
      ],
      "properties": {
       "transitions": {
        "minItems": 1
       }
      }
     },
     {
      "required": [
       "exporters"
      ],
      "properties": {
       "exporters": {
        "minItems": 1
       }
      }
     }
    ]
   }
  }
 ],
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]{1,31}$"
  },
  "hex": {
   "type": "string",
   "pattern": "^#[0-9a-fA-F]{6}$"
  },
  "file": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,127}$",
   "not": {
    "pattern": "\\.\\."
   }
  },
  "palette": {
   "type": "object",
   "required": [
    "id",
    "bg",
    "ink",
    "a"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "name": {
     "type": "string"
    },
    "bg": {
     "$ref": "#/$defs/hex"
    },
    "ink": {
     "$ref": "#/$defs/hex"
    },
    "a": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "$ref": "#/$defs/hex"
     }
    }
   }
  },
  "inputs": {
   "type": "array",
   "maxItems": 2,
   "items": {
    "if": {
     "required": [
      "type"
     ],
     "properties": {
      "type": {
       "const": "text"
      }
     }
    },
    "then": {
     "$ref": "#/$defs/textInput"
    },
    "else": {
     "$ref": "#/$defs/mediaInput"
    }
   }
  },
  "show": {
   "type": "object",
   "required": [
    "param"
   ],
   "properties": {
    "param": {
     "type": "string"
    },
    "is": {},
    "not": {},
    "gt": {
     "type": "number"
    },
    "lt": {
     "type": "number"
    }
   },
   "oneOf": [
    {
     "required": [
      "is"
     ]
    },
    {
     "required": [
      "not"
     ]
    },
    {
     "required": [
      "gt"
     ]
    },
    {
     "required": [
      "lt"
     ]
    }
   ]
  },
  "param": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "enum": [
      "range",
      "int",
      "toggle",
      "select",
      "color",
      "point"
     ]
    },
    "label": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "group": {
     "type": "string"
    },
    "hint": {
     "type": "string"
    },
    "mutate": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "show": {
     "$ref": "#/$defs/show"
    },
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "step": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "log": {
     "type": "boolean"
    },
    "randMax": {
     "type": "number"
    },
    "def": {},
    "options": {
     "type": "array",
     "minItems": 2,
     "maxItems": 12,
     "items": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,23}$"
       },
       {
        "type": "object",
        "required": [
         "v"
        ],
        "properties": {
         "v": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
         },
         "l": {
          "type": "string"
         }
        }
       }
      ]
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "enum": [
         "range",
         "int"
        ]
       }
      }
     },
     "then": {
      "required": [
       "min",
       "max",
       "def"
      ],
      "properties": {
       "def": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "int"
       }
      }
     },
     "then": {
      "properties": {
       "min": {
        "type": "integer"
       },
       "max": {
        "type": "integer"
       },
       "def": {
        "type": "integer"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "toggle"
       }
      }
     },
     "then": {
      "properties": {
       "def": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "select"
       }
      }
     },
     "then": {
      "required": [
       "options"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "color"
       }
      }
     },
     "then": {
      "required": [
       "def"
      ],
      "properties": {
       "def": {
        "$ref": "#/$defs/hex"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "point"
       }
      }
     },
     "then": {
      "properties": {
       "def": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       }
      }
     }
    }
   ]
  },
  "params": {
   "type": "object",
   "maxProperties": 32,
   "propertyNames": {
    "pattern": "^[a-z][a-zA-Z0-9]{0,23}$",
    "not": {
     "enum": [
      "palette",
      "invert",
      "tempo",
      "phase",
      "seed",
      "zoom",
      "rotate",
      "loop"
     ]
    }
   },
   "additionalProperties": {
    "$ref": "#/$defs/param"
   }
  },
  "pass": {
   "type": "object",
   "required": [
    "src"
   ],
   "properties": {
    "src": {
     "$ref": "#/$defs/file"
    },
    "scale": {
     "type": "number",
     "minimum": 0.125,
     "maximum": 1
    }
   }
  },
  "passes": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "$ref": "#/$defs/pass"
   }
  },
  "bufferName": {
   "type": "string",
   "pattern": "^[a-z][a-zA-Z0-9]{0,15}$",
   "not": {
    "enum": [
     "input",
     "from",
     "to",
     "output"
    ]
   }
  },
  "graph": {
   "type": "object",
   "required": [
    "passes"
   ],
   "additionalProperties": false,
   "description": "Pass graph: named buffers, pass reads/writes, ping-pong feedback with bounded iteration (within one frame). Ordering rules (a buffer is read only after an earlier pass writes it, or by the pass that writes it; exactly one last pass writes output; ≤ 32 pass executions per frame) are checked by the app.",
   "properties": {
    "buffers": {
     "type": "object",
     "maxProperties": 8,
     "propertyNames": {
      "$ref": "#/$defs/bufferName"
     },
     "additionalProperties": {
      "type": "object",
      "properties": {
       "scale": {
        "type": "number",
        "minimum": 0.125,
        "maximum": 1
       }
      },
      "additionalProperties": false
     }
    },
    "passes": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "object",
      "required": [
       "src"
      ],
      "additionalProperties": false,
      "properties": {
       "src": {
        "$ref": "#/$defs/file"
       },
       "reads": {
        "type": "array",
        "maxItems": 6,
        "items": {
         "type": "string",
         "pattern": "^[a-z][a-zA-Z0-9]{0,15}$"
        }
       },
       "writes": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]{0,15}$"
       },
       "iterate": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
       }
      }
     }
    }
   }
  },
  "entryBase": {
   "type": "object",
   "required": [
    "id",
    "name"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    },
    "blurb": {
     "type": "string"
    },
    "group": {
     "type": "string"
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "cost": {
     "type": "number",
     "minimum": 0,
     "maximum": 24
    },
    "flash": {
     "type": "boolean"
    },
    "params": {
     "$ref": "#/$defs/params"
    },
    "inputs": {
     "$ref": "#/$defs/inputs"
    },
    "passes": {
     "$ref": "#/$defs/passes"
    },
    "graph": {
     "$ref": "#/$defs/graph"
    }
   },
   "not": {
    "required": [
     "passes",
     "graph"
    ]
   }
  },
  "style": {
   "allOf": [
    {
     "$ref": "#/$defs/entryBase"
    },
    {
     "anyOf": [
      {
       "required": [
        "passes"
       ]
      },
      {
       "required": [
        "graph"
       ]
      }
     ]
    }
   ],
   "properties": {
    "palette": {
     "$ref": "#/$defs/id"
    }
   }
  },
  "effect": {
   "allOf": [
    {
     "$ref": "#/$defs/entryBase"
    },
    {
     "anyOf": [
      {
       "required": [
        "passes"
       ]
      },
      {
       "required": [
        "graph"
       ]
      }
     ]
    }
   ],
   "properties": {
    "target": {
     "enum": [
      "layer",
      "finish",
      "any"
     ]
    }
   }
  },
  "transition": {
   "allOf": [
    {
     "$ref": "#/$defs/entryBase"
    },
    {
     "anyOf": [
      {
       "required": [
        "passes"
       ]
      },
      {
       "required": [
        "graph"
       ]
      }
     ]
    }
   ],
   "properties": {
    "duration": {
     "type": "number",
     "minimum": 0.1,
     "maximum": 10
    }
   }
  },
  "exporter": {
   "type": "object",
   "required": [
    "id",
    "name",
    "preset"
   ],
   "additionalProperties": false,
   "description": "Declarative export preset. Exporters never run code: only these settings, only these values.",
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    },
    "blurb": {
     "type": "string"
    },
    "group": {
     "type": "string"
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "preset": {
     "type": "object",
     "required": [
      "format"
     ],
     "additionalProperties": false,
     "properties": {
      "format": {
       "enum": [
        "webm",
        "mp4",
        "png",
        "png-seq"
       ]
      },
      "tier": {
       "enum": [
        720,
        1080,
        1440,
        2160
       ]
      },
      "fps": {
       "enum": [
        24,
        25,
        30,
        50,
        60
       ]
      },
      "loops": {
       "type": "integer",
       "minimum": 1,
       "maximum": 8
      },
      "transparent": {
       "type": "boolean"
      },
      "withAudio": {
       "type": "boolean"
      },
      "quality": {
       "enum": [
        "standard",
        "high",
        "max"
       ]
      },
      "aspect": {
       "enum": [
        "16x9",
        "9x16",
        "1x1",
        "4x5",
        "4x3",
        "21x9"
       ]
      }
     }
    }
   }
  },
  "mediaInput": {
   "type": "object",
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-zA-Z0-9]{0,15}$",
     "not": {
      "enum": [
       "res",
       "p",
       "l",
       "seed",
       "safe",
       "bg",
       "ink",
       "a0",
       "a1",
       "a2",
       "buf0",
       "buf1",
       "buf2",
       "buf3",
       "out"
      ]
     }
    },
    "type": {
     "enum": [
      "image",
      "video",
      "media"
     ]
    },
    "label": {
     "type": "string"
    },
    "fit": {
     "enum": [
      "fill",
      "fit",
      "stretch"
     ]
    },
    "required": {
     "type": "boolean"
    },
    "hint": {
     "type": "string"
    }
   }
  },
  "textInput": {
   "type": "object",
   "required": [
    "id",
    "type",
    "lines"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-zA-Z0-9]{0,15}$",
     "not": {
      "enum": [
       "res",
       "p",
       "l",
       "seed",
       "safe",
       "bg",
       "ink",
       "a0",
       "a1",
       "a2",
       "buf0",
       "buf1",
       "buf2",
       "buf3",
       "out"
      ]
     }
    },
    "type": {
     "const": "text"
    },
    "label": {
     "type": "string"
    },
    "hint": {
     "type": "string"
    },
    "aspect": {
     "type": "number",
     "minimum": 2,
     "maximum": 16,
     "default": 8,
     "description": "Band width : height of every line in the atlas."
    },
    "lines": {
     "type": "array",
     "minItems": 1,
     "maxItems": 3,
     "items": {
      "type": "object",
      "required": [
       "id"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]{0,15}$"
       },
       "label": {
        "type": "string"
       },
       "def": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$",
        "description": "Default text: one line, no control characters, at most maxLength."
       },
       "maxLength": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128,
        "default": 64
       },
       "font": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[\\p{L}\\p{N} _.&+()-]{1,64}$"
         },
         "weight": {
          "enum": [
           100,
           200,
           300,
           400,
           500,
           600,
           700,
           800,
           900
          ]
         }
