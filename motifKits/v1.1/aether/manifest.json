      "params": {
        "scale": {
          "type": "range",
          "label": "Form scale",
          "min": 0.55,
          "max": 2.2,
          "step": 0.01,
          "group": "Form",
          "def": 1,
          "hint": "Overall size of the form."
        },
        "complexity": {
          "type": "range",
          "label": "Billow detail",
          "min": 0,
          "max": 1.2,
          "step": 0.01,
          "group": "Form",
          "def": 0.6,
          "hint": "Adds fine billows on top of the large cloud forms."
        },
        "density": {
          "type": "range",
          "label": "Fog density",
          "min": 0.4,
          "max": 1.8,
          "step": 0.01,
          "group": "Form",
          "def": 1,
          "hint": "How thick the volume is; thicker means more opaque and brighter."
        },
        "depth": {
          "type": "range",
          "label": "View depth",
          "min": 3,
          "max": 10,
          "step": 0.01,
