          "max": 1.7,
          "step": 0.01,
          "group": "Light",
          "def": 1,
          "hint": "Final exposure before the tone map.",
          "randMax": 1.25
        },
        "glow": {
          "type": "range",
          "label": "Bloom mix",
          "min": 0,
          "max": 0.9,
          "step": 0.01,
          "group": "Lens",
          "def": 0.36,
          "hint": "How much bloom is mixed back into the image.",
          "randMax": 0.6
        },
        "threshold": {
          "type": "range",
          "label": "Bloom threshold",
          "min": 0.1,
          "max": 1.5,
          "step": 0.01,
          "group": "Lens",
          "def": 0.85,
          "hint": "Brightness above which pixels bloom. Lower is hazier.",
          "randMax": 1.0
        },
        "radius": {
          "type": "range",
          "label": "Bloom spread",
          "min": 0.75,
          "max": 3,
          "step": 0.01,
          "group": "Lens",
          "def": 1.5,
          "hint": "Width of the bloom halo.",
          "randMax": 2.2
        },
        "cycles": {
          "type": "int",
          "label": "Circuits / loop",
          "min": 1,
          "max": 2,
          "group": "Motion",
          "mutate": 0,
          "def": 1,
          "hint": "Whole circuits per loop keep the seam closed."
        },
        "steps": {
          "type": "int",
          "label": "Volume samples",
          "min": 32,
          "max": 80,
          "group": "Quality",
          "mutate": 0,
          "def": 68,
          "hint": "Volume samples per pixel. Higher is smoother; exposure is held constant."
        },
        "vignette": {
          "type": "range",
          "label": "Vignette",
          "min": 0,
          "max": 0.6,
          "step": 0.01,
          "group": "Lens",
          "def": 0.34,
          "hint": "Edge darkening that holds the eye on the focal point."
        }
      }
    },
