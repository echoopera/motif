    {
      "id": "living-flower",
      "name": "Living Flower",
      "group": "Oriel",
      "palette": "gilt",
      "tags": [
        "oriel",
        "ambient",
        "procedural"
      ],
      "blurb": "A sixfold circle lattice blooms within a golden field.",
      "flash": false,
      "cost": 2,
      "graph": {
        "buffers": {
          "scene": {
            "scale": 1.0
          },
          "bright": {
            "scale": 0.25
          },
          "glow": {
            "scale": 0.125
          },
          "wide": {
            "scale": 0.125
          }
        },
        "passes": [
          {
            "src": "styles/living-flower.glsl",
            "writes": "scene"
          },
          {
            "src": "post/bright.glsl",
            "reads": [
              "scene"
            ],
            "writes": "bright"
          },
          {
            "src": "post/glow.glsl",
            "reads": [
              "bright"
            ],
            "writes": "glow"
          },
          {
            "src": "post/wide.glsl",
            "reads": [
              "bright"
            ],
            "writes": "wide"
          },
          {
            "src": "post/output.glsl",
            "reads": [
              "scene",
              "glow",
              "wide"
            ],
            "writes": "output"
          }
        ]
      },
      "params": {
        "scale": {
          "type": "range",
          "label": "Form scale",
          "min": 0.55,
          "max": 2.2,
          "step": 0.01,
          "group": "Form",
          "def": 1,
          "hint": "Overall size of the form."
        },
        "complexity": {
          "type": "range",
          "label": "Geometric detail",
          "min": 0,
          "max": 1.2,
          "step": 0.01,
          "group": "Form",
          "def": 0.6,
          "hint": "Adds line detail and fine harmonics to the geometry."
        },
        "density": {
          "type": "range",
          "label": "Pattern spread",
          "min": 0.4,
          "max": 1.8,
          "step": 0.01,
          "group": "Form",
          "def": 1,
          "hint": "How far the pattern repeats across the frame."
        },
        "depth": {
          "type": "range",
          "label": "Depth haze",
          "min": 3,
          "max": 10,
          "step": 0.01,
          "group": "Material",
          "def": 6.5,
          "hint": "How quickly deeper layers fade into the dark."
        },
        "membrane": {
          "type": "range",
          "label": "Line weight",
          "min": 0.5,
          "max": 2,
          "step": 0.01,
          "group": "Material",
          "def": 1,
          "hint": "Thickness of the drawn lines."
        },
        "radiance": {
          "type": "range",
          "label": "Radiance",
          "min": 0.4,
          "max": 2,
          "step": 0.01,
          "group": "Light",
          "def": 1.1,
          "hint": "Brightness of the light the form emits; also drives bloom.",
          "randMax": 1.5
        },
        "exposure": {
          "type": "range",
          "label": "Exposure",
          "min": 0.45,
          "max": 1.7,
          "step": 0.01,
          "group": "Light",
          "def": 1,
          "hint": "Final exposure before the tone map.",
          "randMax": 1.25
        },
        "glow": {
          "type": "range",
          "label": "Bloom mix",
          "min": 0,
          "max": 0.9,
          "step": 0.01,
          "group": "Lens",
          "def": 0.36,
          "hint": "How much bloom is mixed back into the image.",
          "randMax": 0.6
        },
        "threshold": {
          "type": "range",
          "label": "Bloom threshold",
          "min": 0.1,
          "max": 1.5,
          "step": 0.01,
          "group": "Lens",
          "def": 0.68,
          "hint": "Brightness above which pixels bloom. Lower is hazier.",
          "randMax": 1.0
        },
        "radius": {
          "type": "range",
          "label": "Bloom spread",
          "min": 0.75,
          "max": 3,
          "step": 0.01,
          "group": "Lens",
          "def": 1.5,
          "hint": "Width of the bloom halo.",
          "randMax": 2.2
        },
        "cycles": {
          "type": "int",
          "label": "Circuits / loop",
          "min": 1,
          "max": 2,
          "group": "Motion",
          "mutate": 0,
          "def": 1,
          "hint": "Whole circuits per loop keep the seam closed."
        },
        "layers": {
          "type": "int",
          "label": "Depth layers",
          "min": 1,
          "max": 4,
          "group": "Form",
          "mutate": 0,
          "def": 3,
          "hint": "Number of stacked copies, alternate ones counter-rotate."
        },
        "vignette": {
          "type": "range",
          "label": "Vignette",
          "min": 0,
          "max": 0.6,
          "step": 0.01,
          "group": "Lens",
          "def": 0.34,
          "hint": "Edge darkening that holds the eye on the focal point."
        }
      }
    },
