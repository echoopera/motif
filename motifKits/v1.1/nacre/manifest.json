          "max": 3,
          "step": 0.01,
          "group": "Lens",
          "def": 1.5,
          "hint": "Width of the bloom halo.",
          "randMax": 2.2
        },
        "cycles": {
          "type": "int",
          "label": "Circuits / loop",
          "min": 1,
          "max": 2,
          "group": "Motion",
          "mutate": 0,
          "def": 1,
          "hint": "Whole circuits per loop keep the seam closed."
        },
        "population": {
