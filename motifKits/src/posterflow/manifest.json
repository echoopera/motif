{
  "format": "motif-kit@4",
  "id": "posterflow",
  "name": "Posterflow",
  "version": "1.0.0",
  "author": "Motif",
  "description": "Fluid poster treatments for your own images and clips: quantized colour bands, liquid flow-warps, vein lines, streak smears and ink drags. Three styles, a layer effect and a liquid cut transition.",
  "license": "MIT",
  "accent": "#4D7CFF",
  "common": "common.glsl",
  "capabilities": [
    "media"
  ],
  "palettes": [
    {
      "id": "tidal",
      "name": "Tidal",
      "bg": "#04070F",
      "ink": "#EEF3FF",
      "a": [
        "#3F6FFF",
        "#A8D2FF",
        "#0A1C55"
      ]
    },
    {
      "id": "ember",
      "name": "Ember",
      "bg": "#08040A",
      "ink": "#FFF1E6",
      "a": [
        "#FF4A1C",
        "#FFB38A",
        "#4A0B1E"
      ]
    },
    {
      "id": "rosewater",
      "name": "Rosewater",
      "bg": "#16060B",
      "ink": "#FFF0F2",
      "a": [
        "#E0457B",
        "#F7B6C6",
        "#5A0F2A"
      ]
    },
    {
      "id": "mineral",
      "name": "Mineral",
      "bg": "#07080B",
      "ink": "#F5EFE3",
      "a": [
        "#6C8FD6",
        "#E8C9A0",
        "#232A44"
      ]
    }
  ],
  "inputs": [
    {
      "id": "source",
      "type": "media",
      "label": "Source",
      "fit": "fill",
      "hint": "Photo or clip to treat. Without one a palette ink marble plays."
    }
  ],
  "styles": [
    {
      "id": "marble-flow",
      "name": "Marble Flow",
      "group": "Posterflow",
      "palette": "tidal",
      "tags": [
        "media",
        "posterize",
        "liquid",
        "marble"
      ],
      "cost": 1,
      "blurb": "Pours your image through a looping flow-warp and snaps it to quantized colour bands with vein lines.",
      "flash": false,
      "passes": [
        {
          "src": "styles/marble-flow.glsl"
        }
      ],
      "params": {
        "scale": {
          "type": "range",
          "label": "Flow scale",
          "min": 0.4,
          "max": 4,
          "def": 1.4,
          "step": 0.01,
          "group": "Flow",
          "log": true
        },
        "warp": {
          "type": "range",
          "label": "Warp",
          "min": 0,
          "max": 2.5,
          "def": 1.1,
          "step": 0.01,
          "group": "Flow"
        },
        "turns": {
          "type": "int",
          "label": "Cycles / loop",
          "min": 1,
          "max": 3,
          "def": 1,
          "group": "Motion",
          "hint": "Whole cycles per loop; the loop always closes."
        },
        "swirl": {
          "type": "range",
          "label": "Vortex",
          "min": 0,
          "max": 2,
          "def": 0.6,
          "step": 0.01,
          "group": "Flow"
        },
        "drift": {
          "type": "range",
          "label": "Drift",
          "min": 0,
          "max": 1.5,
          "def": 0.35,
          "step": 0.01,
          "group": "Motion"
        },
        "bands": {
          "type": "int",
          "label": "Bands",
          "min": 2,
          "max": 16,
          "def": 7,
          "group": "Poster",
          "randMax": 10,
          "hint": "Number of tonal steps."
        },
        "soft": {
          "type": "range",
          "label": "Edge softness",
          "min": 0,
          "max": 1,
          "def": 0.2,
          "step": 0.01,
          "group": "Poster",
          "hint": "0 is a hard posterize edge."
        },
        "hue": {
          "type": "range",
          "label": "Hue steps",
          "min": 0,
          "max": 1,
          "def": 0.35,
          "step": 0.01,
          "group": "Poster",
          "hint": "Quantize each colour channel as well as brightness."
        },
        "mode": {
          "type": "select",
          "label": "Colour",
          "options": [
            {
              "v": "source",
              "l": "Source"
            },
            {
              "v": "pal",
              "l": "Palette ramp"
            },
            {
              "v": "mix",
              "l": "Mix"
            }
          ],
          "def": "source",
          "group": "Poster",
          "mutate": 0
        },
        "palMix": {
          "type": "range",
          "label": "Palette mix",
          "min": 0,
          "max": 1,
          "def": 0.5,
          "step": 0.01,
          "group": "Poster",
          "show": {
            "param": "mode",
            "is": "mix"
          }
        },
        "veins": {
          "type": "range",
          "label": "Veins",
          "min": 0,
          "max": 1,
          "def": 0.4,
          "step": 0.01,
          "group": "Poster",
          "hint": "Thin dark lines along band edges."
        },
        "veinW": {
          "type": "range",
          "label": "Vein width",
          "min": 0.5,
          "max": 4,
          "def": 1.1,
          "step": 0.01,
          "group": "Poster",
          "unit": "px",
          "log": true
        },
        "vein": {
          "type": "color",
          "label": "Vein colour",
          "def": "#06070C",
          "group": "Poster"
        },
        "vignette": {
          "type": "range",
          "label": "Vignette",
          "min": 0,
          "max": 0.6,
          "def": 0.25,
          "step": 0.01,
          "group": "Lens",
          "randMax": 0.5
