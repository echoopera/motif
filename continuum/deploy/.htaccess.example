# Rename to .htaccess (Apache with mod_headers, mod_mime, mod_deflate)
AddType text/javascript .js
AddType text/css .css
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/manifest+json image/svg+xml
<FilesMatch "\.(html|js|css|webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(woff2|png|svg)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
