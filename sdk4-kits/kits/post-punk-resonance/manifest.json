    {
      "id": "post-punk-hero",
      "name": "Post-Punk Resonance Hero",
      "group": "Post-Punk Resonance",
      "tags": [
        "flagship",
        "stripes",
        "rings"
      ],
      "blurb": "Stripes, black ring bands, a red wave cut and an acid-yellow slab step to new poses on two beats.",
      "palette": "acid-warm",
      "flash": false,
      "cost": 2,
      "passes": [
        {
          "src": "styles/post-punk-hero.glsl"
        }
      ],
      "params": {
        "pitch": {
          "type": "range",
          "label": "Stripe pitch",
          "min": 4,
          "max": 28,
          "def": 12,
          "step": 0.5,
          "group": "Form",
          "unit": "px",
          "hint": "Stripe period in screen pixels. Filtered, so it stays clean as it changes."
        },
        "rings": {
          "type": "int",
          "label": "Ring count",
          "min": 3,
          "max": 12,
          "def": 6,
          "group": "Form",
          "hint": "Number of black ring bands. A spatial count.",
          "mutate": 0.3
        },
        "wave": {
          "type": "range",
          "label": "Wave amplitude",
          "min": 0.02,
          "max": 0.3,
          "def": 0.14,
          "step": 0.0014,
          "group": "Form",
          "hint": "Height of the wave traces, scene units."
        },
        "black": {
          "type": "range",
          "label": "Black area",
          "min": 0.2,
          "max": 0.7,
          "def": 0.45,
          "step": 0.0025,
          "group": "Material",
          "hint": "How much of the composition is black."
        },
        "accent": {
          "type": "range",
          "label": "Accent area",
          "min": 0.05,
          "max": 0.35,
          "def": 0.15,
          "step": 0.0015,
          "group": "Material",
          "hint": "Size of the yellow and red accents."
        },
        "slice": {
          "type": "range",
          "label": "Slice displacement",
          "min": 0,
          "max": 0.25,
          "def": 0.09,
          "step": 0.0013,
          "group": "Motion",
          "hint": "Horizontal slices shift during moves and return to zero at rest."
        },
        "hold": {
          "type": "range",
          "label": "Hold fraction",
          "min": 0.15,
          "max": 0.65,
          "def": 0.35,
          "step": 0.0025,
          "group": "Motion",
          "hint": "Share of each beat spent at rest."
        },
        "beats": {
          "type": "int",
          "label": "Beats per loop",
          "min": 1,
          "max": 4,
          "def": 2,
          "group": "Motion",
          "hint": "Rhythmic segments per loop. Each beat eases to the next pose.",
          "mutate": 0
        },
        "stepped": {
          "type": "toggle",
          "label": "On twos",
          "def": false,
          "group": "Motion",
          "hint": "Hold each move in six stepped poses, like animation on twos."
        },
        "exposure": {
          "type": "range",
          "label": "Exposure",
          "min": 0.7,
          "max": 1.4,
          "def": 1,
          "step": 0.01,
          "unit": "×",
          "group": "Light",
          "hint": "Overall level of the printed colours."
        },
        "vignette": {
          "type": "range",
          "label": "Vignette",
          "min": 0,
          "max": 0.5,
          "def": 0,
          "step": 0.01,
          "group": "Lens",
          "hint": "Darkens the frame edge. Off by default for graphic work.",
          "randMax": 0.2
        },
        "quality": {
          "type": "select",
          "label": "Quality",
          "options": [
            {
              "v": "live",
              "l": "Live"
            },
            {
              "v": "balanced",
              "l": "Balanced"
            },
            {
              "v": "export",
              "l": "Export"
            }
          ],
          "def": "export",
          "mutate": 0,
          "group": "Quality",
          "hint": "Sample counts only. Composition, phase and exposure stay the same."
        }
      }
