      "name": "Partial Circle",
      "group": "Deconstruct Field",
      "tags": [
        "arcs",
        "circle"
      ],
      "blurb": "Concentric partial circles of different weights rotate through short, eased arcs.",
      "palette": "sand-teal",
      "flash": false,
      "cost": 2,
      "passes": [
        {
          "src": "styles/partial-circle.glsl"
        }
      ],
      "params": {
        "planes": {
          "type": "int",
          "label": "Plane count",
          "min": 6,
          "max": 28,
          "def": 8,
          "group": "Form",
          "hint": "Number of planes in the composition. Most are small; a few dominate.",
          "mutate": 0.3
        },
        "arcR": {
          "type": "range",
          "label": "Arc radius",
          "min": 0.1,
          "max": 0.65,
          "def": 0.5,
          "step": 0.001,
          "group": "Form",
          "hint": "Radius of the principal cobalt arc in scene units."
        },
        "grid": {
          "type": "range",
          "label": "Grid spacing",
          "min": 0.015,
          "max": 0.12,
          "def": 0.045,
          "step": 0.001,
          "group": "Form",
          "hint": "Spacing of the hairline grids that ride on the planes."
        },
        "lineW": {
          "type": "range",
          "label": "Line width",
          "min": 0.7,
          "max": 3,
          "def": 1.2,
          "step": 0.05,
          "group": "Material",
          "unit": "px",
          "hint": "Hairline width in screen pixels."
        },
        "sep": {
          "type": "range",
          "label": "Layer separation",
          "min": 0,
          "max": 0.15,
          "def": 0.05,
          "step": 0.0001,
          "group": "Light",
          "hint": "Soft shadow offset between layers. 0 prints everything flat."
        },
        "offset": {
          "type": "range",
          "label": "Offset amplitude",
          "min": 0,
          "max": 0.35,
          "def": 0.08,
          "step": 0.001,
          "group": "Motion",
          "hint": "How far planes travel on their moves."
        },
        "rot": {
          "type": "range",
          "label": "Rotation amplitude",
          "min": 0,
          "max": 0.5,
          "def": 0.3,
          "step": 0.001,
          "group": "Motion",
          "hint": "How far planes rotate on their moves, radians."
        },
        "hold": {
          "type": "range",
          "label": "Hold fraction",
          "min": 0.1,
          "max": 0.6,
          "def": 0.3,
          "step": 0.001,
          "group": "Motion",
          "hint": "Share of each half cycle spent at rest."
        },
        "recomp": {
          "type": "int",
          "label": "Recompositions per loop",
          "min": 1,
          "max": 3,
          "def": 1,
          "group": "Motion",
          "hint": "Whole in-hold-out-return cycles per loop.",
          "mutate": 0
        },
        "keyAngle": {
          "type": "range",
          "label": "Shadow direction",
          "min": -180,
          "max": 180,
          "def": -45,
          "step": 1,
          "unit": "°",
          "group": "Light",
          "hint": "Direction the soft layer shadow falls, degrees.",
          "randMax": 180
        },
        "exposure": {
          "type": "range",
          "label": "Exposure",
          "min": 0.7,
          "max": 1.4,
          "def": 1,
          "step": 0.01,
          "unit": "×",
          "group": "Light",
          "hint": "Overall level of the printed colours."
        },
        "vignette": {
          "type": "range",
          "label": "Vignette",
          "min": 0,
          "max": 0.5,
          "def": 0,
          "step": 0.01,
          "group": "Lens",
          "hint": "Darkens the frame edge. Off by default for graphic work.",
          "randMax": 0.2
        },
        "quality": {
          "type": "select",
          "label": "Quality",
          "options": [
            {
              "v": "live",
              "l": "Live"
            },
            {
              "v": "balanced",
              "l": "Balanced"
            },
            {
              "v": "export",
              "l": "Export"
            }
          ],
          "def": "export",
          "mutate": 0,
          "group": "Quality",
          "hint": "Sample counts only. Composition, phase and exposure stay the same."
        }
      }
    },
