template <class V> inline V rsqrt(V x) { return V(1) / sqrt(x); }
template <class V> inline V abs(V x) { if constexpr (std::is_arithmetic_v<V>) return x < 0 ? -x : x; else { V r; for (int i = 0; i < lanes<V>(); i++) r[i] = x[i] < 0 ? -x[i] : x[i]; return r; } }
template <class V> inline V fract(V x) { return x - floor(x); }
template <class V> inline V sign(V x) { if constexpr (std::is_arithmetic_v<V>) return x > 0 ? 1 : (x < 0 ? -1 : 0); else { V r; for (int i = 0; i < lanes<V>(); i++) r[i] = x[i] > 0 ? 1 : (x[i] < 0 ? -1 : 0); return r; } }
template <class V> inline V pow(V a, V b) { if constexpr (std::is_arithmetic_v<V>) return ::powf(a, b); else { V r; for (int i = 0; i < lanes<V>(); i++) r[i] = ::powf(a[i], b[i]); return r; } }
template <class V> inline V atan2(V y, V x) { if constexpr (std::is_arithmetic_v<V>) return ::atan2f(y, x); else { V r; for (int i = 0; i < lanes<V>(); i++) r[i] = ::atan2f(y[i], x[i]); return r; } }
// SwiftShader (the reference renderer here) lowers min/max to SSE minps/maxps, which return the SECOND operand when either is NaN.
template <class T> inline T min(T a, T b) { if constexpr (std::is_arithmetic_v<T>) return a < b ? a : b; else { T r; for (int i = 0; i < lanes<T>(); i++) r[i] = a[i] < b[i] ? a[i] : b[i]; return r; } }
template <class T> inline T max(T a, T b) { if constexpr (std::is_arithmetic_v<T>) return a > b ? a : b; else { T r; for (int i = 0; i < lanes<T>(); i++) r[i] = a[i] > b[i] ? a[i] : b[i]; return r; } }
template <class T> inline T fmin(T a, T b) { if constexpr (std::is_arithmetic_v<T>) return std::isnan(a) ? b : (std::isnan(b) ? a : (b < a ? b : a)); else { T r; for (int i = 0; i < lanes<T>(); i++) r[i] = fmin(a[i], b[i]); return r; } }
template <class T> inline T fmax(T a, T b) { if constexpr (std::is_arithmetic_v<T>) return std::isnan(a) ? b : (std::isnan(b) ? a : (a < b ? b : a)); else { T r; for (int i = 0; i < lanes<T>(); i++) r[i] = fmax(a[i], b[i]); return r; } }
template <class T> inline T clamp(T x, T lo, T hi) { return min(max(x, lo), hi); }
template <class T> inline T mix(T a, T b, T t) { return a + (b - a) * t; }
template <class T> inline T step(T e, T x) { if constexpr (std::is_arithmetic_v<T>) return x < e ? 0 : 1; else { T r; for (int i = 0; i < lanes<T>(); i++) r[i] = x[i] < e[i] ? 0 : 1; return r; } }
template <class T> inline T smoothstep(T a, T b, T x) { T t = clamp((x - a) / (b - a), T(0), T(1)); return t * t * (T(3) - T(2) * t); }
template <class V> inline float dot(V a, V b) { if constexpr (std::is_arithmetic_v<V>) return a * b; else { float s = 0; for (int i = 0; i < lanes<V>(); i++) s += a[i] * b[i]; return s; } }
template <class V> inline float length(V a) { return ::sqrtf(dot(a, a)); }
template <class V> inline float distance(V a, V b) { return length(a - b); }
template <class V> inline V normalize(V a) { return a / length(a); }
inline float3 cross(float3 a, float3 b) { return float3{a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x}; }
template <class V> inline V refract(V i, V n, float eta) { float k = 1.0f - eta * eta * (1.0f - dot(n, i) * dot(n, i)); if (k < 0.0f) return V(0); return i * eta - n * (eta * dot(n, i) + ::sqrtf(k)); }
template <class Col, int C> inline fmat<Col, C> transpose(const fmat<Col, C>& m) { fmat<Col, C> r{}; for (int i = 0; i < C; i++) for (int j = 0; j < C; j++) r.c[i][j] = m.c[j][i]; return r; }
template <class V> inline V reflect(V i, V n) { return i - n * (2.0f * dot(n, i)); }
template <class V> inline auto isnan(V x) { if constexpr (std::is_arithmetic_v<V>) return std::isnan(x); else return x != x; }
template <class V> inline auto isinf(V x) { if constexpr (std::is_arithmetic_v<V>) return std::isinf(x); else { return abs(x) > 3.4e38f; } }
template <class V> inline bool any(V x) { if constexpr (std::is_arithmetic_v<V>) return x != 0; else { for (int i = 0; i < lanes<V>(); i++) if (x[i]) return true; return false; } }
template <class V> inline bool all(V x) { if constexpr (std::is_arithmetic_v<V>) return x != 0; else { for (int i = 0; i < lanes<V>(); i++) if (!x[i]) return false; return true; } }
template <class V, class B> inline V select(V a, V b, B c) { if constexpr (std::is_arithmetic_v<V>) return c ? b : a; else { V r; for (int i = 0; i < lanes<V>(); i++) r[i] = c[i] ? b[i] : a[i]; return r; } }
template <class V> inline V bool_norm(V x) { if constexpr (std::is_same_v<V, bool>) return x; else return -x; }
// Derivatives need neighbouring fragments. The CPU driver renders a pass twice: the first run records every derivative
// call's argument per pixel (in call order), the second replays 2x2-quad differences. Matches SwiftShader (what headless
// Chromium uses): dFdx per row across the quad's column pair, dFdy down the quad's left column.
struct DerivState { int mode = 0, w = 0, h = 0, x = 0, y = 0, k = 0; std::vector<std::vector<float>>* logs = nullptr; };
inline DerivState g_deriv;
template <class V> inline void d_store(std::vector<float>& l, V v) { float4 q = {0, 0, 0, 0}; for (int i = 0; i < lanes<V>(); i++) q[i] = at(v, i); for (int i = 0; i < 4; i++) l.push_back(q[i]); }
template <class V> inline V d_load(int px, int py, int k) {
  V r{}; const auto& l = (*g_deriv.logs)[(size_t)py * g_deriv.w + px]; if ((size_t)(4 * k + 4) > l.size()) return r;
  if constexpr (std::is_arithmetic_v<V>) r = l[4 * k]; else for (int i = 0; i < lanes<V>(); i++) r[i] = l[4 * k + i];
  return r;
}
// Quad geometry in GL window space (y up): the pair base is the even-y row, which is row h-1-(((h-1-y)) & ~1) top-down.
inline int d_row0(const DerivState& D) { return D.h - 1 - ((D.h - 1 - D.y) & ~1); }
inline int d_row1(const DerivState& D) { return std::max(0, d_row0(D) - 1); }
template <class V> inline V d_diff(V v, bool horizontal) {
  auto& D = g_deriv; int k = D.k++;
  if (D.mode == 1) { d_store((*D.logs)[(size_t)D.y * D.w + D.x], v); return V(0); }
  if (D.mode != 2) return V(0);
  int x0 = D.x & ~1, x1 = std::min(D.w - 1, x0 + 1), r0 = d_row0(D), r1 = d_row1(D);
  if (horizontal) return d_load<V>(x1, r0, k) - d_load<V>(x0, r0, k);
  return d_load<V>(x0, r0, k) - d_load<V>(x0, r1, k);      // Metal's dfdy points down (+pos.y)
}
template <class V> inline V dfdx(V v) { return d_diff(v, true); }
template <class V> inline V dfdy(V v) { return d_diff(v, false); }
template <class V> inline V fwidth(V v) {
  auto& D = g_deriv; int k = D.k++;
  if (D.mode == 1) { d_store((*D.logs)[(size_t)D.y * D.w + D.x], v); return V(0); }
  if (D.mode != 2) return V(0);
  int x0 = D.x & ~1, x1 = std::min(D.w - 1, x0 + 1), r0 = d_row0(D), r1 = d_row1(D);
  V dx = d_load<V>(x1, r0, k) - d_load<V>(x0, r0, k), dy = d_load<V>(x0, r0, k) - d_load<V>(x0, r1, k);
  return abs(dx) + abs(dy);
}
template <class T, class S> inline T as_type(S x) { static_assert(sizeof(T) == sizeof(S), "as_type size"); return __builtin_bit_cast(T, x); }
