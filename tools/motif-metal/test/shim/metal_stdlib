struct sampler { template <class... A> constexpr sampler(A...) {} };
struct level { float v; level(float x) : v(x) {} };
template <class T> struct texture2d {
  const float* data = nullptr; int w = 1, h = 1;   // linear, premultiplied RGBA
  float4 texel(int x, int y) const { x = std::max(0, std::min(w - 1, x)); y = std::max(0, std::min(h - 1, y)); if (!data) return float4{0, 0, 0, 0}; const float* p = data + 4 * (y * w + x); return float4{p[0], p[1], p[2], p[3]}; }
  float4 sample(sampler, float2 uv) const {
    float fx = uv.x * w - 0.5f, fy = uv.y * h - 0.5f; int x0 = (int)::floorf(fx), y0 = (int)::floorf(fy); float tx = fx - x0, ty = fy - y0;
    float4 a = texel(x0, y0), b = texel(x0 + 1, y0), c = texel(x0, y0 + 1), d = texel(x0 + 1, y0 + 1);
    return (a * (1 - tx) + b * tx) * (1 - ty) + (c * (1 - tx) + d * tx) * ty;
  }
  float4 sample(sampler s, float2 uv, level) const { return sample(s, uv); }
  float4 read(uint2 p, uint) const { return texel((int)p.x, (int)p.y); }
  uint get_width(uint = 0) const { return w; }
  uint get_height(uint = 0) const { return h; }
};
