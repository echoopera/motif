template <class T, size_t N> using array = std::array<T, N>;

template <class V> constexpr int lanes() { if constexpr (std::is_arithmetic_v<V>) return 1; else return __builtin_vectorelements(V); }
template <class V> using elem_t = std::remove_cv_t<std::remove_reference_t<decltype(std::declval<V&>()[0])>>;
template <class V> inline auto at(const V& v, int i) { if constexpr (std::is_arithmetic_v<V>) return v; else return v[i]; }

// ---- constructors ----------------------------------------------------------------------------------------------
template <class T> inline void push(T* out, int& n, T s) { out[n++] = s; }
template <class T, class S, std::enable_if_t<std::is_arithmetic_v<S>, int> = 0> inline void flat(T* out, int& n, S s) { out[n++] = (T)s; }
template <class T, class S, std::enable_if_t<!std::is_arithmetic_v<S>, int> = 0> inline void flat(T* out, int& n, S v) { for (int i = 0; i < lanes<S>(); i++) out[n++] = (T)v[i]; }
template <class V, class... A> inline V mk(A... a) {
  using T = elem_t<V>; constexpr int N = lanes<V>();
  T tmp[16]; int n = 0; (flat<T>(tmp, n, a), ...);
  V r{};
  if (n == 1) { for (int i = 0; i < N; i++) r[i] = tmp[0]; } else { for (int i = 0; i < N && i < n; i++) r[i] = tmp[i]; }
  return r;
}
#define MK(V) template <class... A> inline V mk_##V(A... a) { return mk<V>(a...); }
MK(float2) MK(float3) MK(float4) MK(int2) MK(int3) MK(int4) MK(uint2) MK(uint3) MK(uint4) MK(bool2) MK(bool3) MK(bool4)

// ---- matrices (column-major, like GLSL and Metal) ---------------------------------------------------------------
template <class Col, int C> struct fmat {
  Col c[C];
  Col& operator[](int i) { return c[i]; }
  const Col& operator[](int i) const { return c[i]; }
};
typedef fmat<float2, 2> float2x2; typedef fmat<float3, 3> float3x3; typedef fmat<float4, 4> float4x4;
template <class... A> inline float2x2 mk_float2x2(A... a) { float2x2 m{}; if constexpr (sizeof...(A) == 1) { float2 d[] = {}; (void)d; float s[] = {(float)a...}; m.c[0][0] = s[0]; m.c[1][1] = s[0]; } else { float2 cols[] = {a...}; for (int i = 0; i < 2; i++) m.c[i] = cols[i]; } return m; }
template <class... A> inline float3x3 mk_float3x3(A... a) { float3x3 m{}; if constexpr (sizeof...(A) == 1) { float s[] = {(float)a...}; for (int i = 0; i < 3; i++) m.c[i][i] = s[0]; } else { float3 cols[] = {a...}; for (int i = 0; i < 3; i++) m.c[i] = cols[i]; } return m; }
template <class... A> inline float4x4 mk_float4x4(A... a) { float4x4 m{}; if constexpr (sizeof...(A) == 1) { float s[] = {(float)a...}; for (int i = 0; i < 4; i++) m.c[i][i] = s[0]; } else { float4 cols[] = {a...}; for (int i = 0; i < 4; i++) m.c[i] = cols[i]; } return m; }
template <class Col, int C> inline Col operator*(const fmat<Col, C>& m, const Col& v) { Col r = m.c[0] * v[0]; for (int i = 1; i < C; i++) r += m.c[i] * v[i]; return r; }
template <class Col, int C> inline Col operator*(const Col& v, const fmat<Col, C>& m) { Col r{}; for (int i = 0; i < C; i++) { float s = 0; for (int k = 0; k < C; k++) s += v[k] * m.c[i][k]; r[i] = s; } return r; }
template <class Col, int C> inline fmat<Col, C> operator*(const fmat<Col, C>& a, const fmat<Col, C>& b) { fmat<Col, C> r{}; for (int i = 0; i < C; i++) r.c[i] = a * b.c[i]; return r; }
template <class Col, int C> inline fmat<Col, C> operator*(const fmat<Col, C>& a, float s) { fmat<Col, C> r{}; for (int i = 0; i < C; i++) r.c[i] = a.c[i] * s; return r; }
